// Configuração de publicação na Cloudflare.
// - Site público: arquivos estáticos da pasta dist/ (gerada pelo `npm run build`).
// - Servidor (worker/index.ts): atende /painel/*, /api/*, /proposta/nova e a loja de fotos (/e/* e /f/*).
// - Banco de dados D1 "venart": criado automaticamente no primeiro deploy.
// - Senha do painel: segredo ADMIN_PASSWORD (definido no painel da Cloudflare, nunca aqui).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venart",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público https://venart.gustavovesss.workers.dev
  "workers_dev": true,
  // Cada branch/pull request ganha um link de pré-visualização próprio.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/painel", "/painel/*", "/api/*", "/proposta/nova", "/proposta/nova/", "/e/*", "/f/*", "/d/*", "/pedido/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "venart"
    }
  ],
  // Loja de fotos: arquivos dos eventos (bucket privado, criado automaticamente no deploy).
  // Só o servidor acessa; o público recebe apenas prévias com marca d'água via /f/.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "venart-fotos"
    }
  ],
  // Venda online — segredos definidos no painel da Cloudflare (tipo "Secret", para não serem apagados no deploy):
  //   InfinitePay:  INFINITEPAY_HANDLE (seu @, sem o @) e, opcional, INFINITEPAY_API_KEY
  //   Mercado Pago: MP_ACCESS_TOKEN e MP_WEBHOOK_SECRET
  // Com os dois, usa a InfinitePay (ou o que estiver em PAYMENT_PROVIDER). Sem nenhum, pedido pelo WhatsApp.
  // Repositório onde o painel grava as edições de preços e fotos.
  // O token fica no segredo GITHUB_TOKEN (definido no painel da Cloudflare).
  "vars": {
    "GITHUB_REPO": "gustavovenanciogit/service.photo",
    "GITHUB_BRANCH": "main"
  },
  // Tarefa diária (03:17 em Manaus = 07:17 UTC): apaga as fotos de eventos com prazo de download encerrado.
  "triggers": { "crons": ["17 7 * * *"] },
  "observability": { "enabled": true }
}
