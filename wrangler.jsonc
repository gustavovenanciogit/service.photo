// Configuração de publicação na Cloudflare.
// - Site público: arquivos estáticos da pasta dist/ (gerada pelo `npm run build`).
// - Servidor (worker/index.ts): só atende /painel/*, /api/* e /proposta/nova (login e dados do painel).
// - Banco de dados D1 "venart": criado automaticamente no primeiro deploy.
// - Senha do painel: segredo ADMIN_PASSWORD (definido no painel da Cloudflare, nunca aqui).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venart",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público https://venart.gustavovesss.workers.dev
  "workers_dev": true,
  // Cada branch/pull request ganha um link de pré-visualização próprio.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/painel", "/painel/*", "/api/*", "/proposta/nova", "/proposta/nova/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "venart"
    }
  ],
  "observability": { "enabled": true }
}
