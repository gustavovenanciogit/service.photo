// Configuração de publicação na Cloudflare (Workers com arquivos estáticos).
// O site é 100% estático: a Cloudflare só serve a pasta dist/ gerada pelo build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venart",
  "compatibility_date": "2026-10-01",
  // Endereço público https://venart.gustavovesss.workers.dev
  "workers_dev": true,
  // Cada branch/pull request ganha um link de pré-visualização próprio.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
