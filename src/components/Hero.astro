---
/**
 * Topo da página inicial.
 * Visual: mosaico de 3 fotos definido em src/data/portfolio.ts (heroMosaic).
 * Se as fotos do mosaico não existirem, usa a 1ª foto de src/assets/hero/ ou um espaço reservado.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { showPendingNotices, site } from '@/config/site';
import { heroMosaic } from '@/data/portfolio';
import { getPortfolioPhoto, heroImage } from '@/lib/images';
import { messages, whatsappLink } from '@/lib/whatsapp';

const mosaic = heroMosaic
  .map((m) => ({ ...m, photo: getPortfolioPhoto(m.file) }))
  .filter((m): m is typeof m & { photo: NonNullable<typeof m.photo> } => !!m.photo);
const useMosaic = mosaic.length === 3;
---

<section id="inicio" class="relative overflow-hidden" data-wa-message={messages.general()}>
  <div class="container-site grid items-center gap-10 pt-8 pb-16 md:pt-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:pb-24">
    <div data-reveal>
      <p class="eyebrow">Fotógrafo em {site.city} · {site.stateCode}</p>
      <h1 class="mt-4 text-[3.4rem] font-extrabold sm:text-7xl lg:text-[5.6rem]">
        Seus melhores momentos <span class="text-brand">merecem ser registrados.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">
        Fotografia esportiva, ensaios e cobertura de eventos em {site.city}. Conheça meus serviços e encontre o
        pacote ideal para você.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#servicos" class="btn btn-primary">Conhecer serviços <Icon name="arrow-right" size={18} /></a>
        <a href={whatsappLink(site.whatsappNumber, messages.quote())} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          <Icon name="whatsapp" size={20} class="text-brand" /> Solicitar orçamento
        </a>
      </div>
    </div>

    <div data-reveal class="relative">
      <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-brand-deep/25 blur-2xl" aria-hidden="true"></div>
      {
        useMosaic ? (
          <div class="grid aspect-[5/6] grid-cols-[1.35fr_1fr] grid-rows-2 gap-2.5 sm:gap-3">
            {mosaic.map((m, i) => (
              <a
                href="#portfolio"
                class:list={[
                  'group relative overflow-hidden rounded-2xl border border-line sm:rounded-3xl',
                  i === 0 && 'row-span-2',
                ]}
                aria-label={`Ver portfólio: ${m.photo.alt}`}
              >
                <Image
                  src={m.photo.src}
                  alt={m.photo.alt}
                  widths={i === 0 ? [400, 640, 900] : [300, 480]}
                  sizes={i === 0 ? '(min-width: 1024px) 28vw, 58vw' : '(min-width: 1024px) 20vw, 42vw'}
                  loading="eager"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  style={`object-position:${m.position ?? '50% 50%'}`}
                  class="h-full w-full object-cover transition duration-700 ease-smooth group-hover:scale-[1.04]"
                />
                <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-bg/80 to-transparent p-3 pt-10 sm:p-4 sm:pt-12">
                  <span class="font-display text-xs font-bold tracking-[0.18em] text-ink uppercase sm:text-sm">{m.label}</span>
                </span>
              </a>
            ))}
          </div>
        ) : heroImage ? (
          <Image
            src={heroImage}
            alt={`Fotografia de destaque — ${site.name}`}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full rounded-3xl border border-line object-cover"
          />
        ) : (
          <div class="grid aspect-[4/5] w-full place-items-center rounded-3xl border border-dashed border-brand/30 bg-gradient-to-br from-card to-bg-2 text-center">
            <div class="px-8 text-muted">
              <Icon name="camera" size={48} class="mx-auto text-brand/70" />
              <p class="mt-4 font-display text-xl tracking-wide uppercase text-ink/80">{site.tagline}</p>
              {showPendingNotices && <p class="mt-1 text-xs">Configure heroMosaic em src/data/portfolio.ts</p>}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
