---
import Icon from './Icon.astro';
import type { Category } from '@/data/categories';

interface Props {
  category: Category;
}
const { category } = Astro.props;
---

<article data-reveal class="card card-hover group relative flex flex-col p-6 sm:p-7">
  <div class="flex items-start justify-between">
    <span class="grid size-14 place-items-center rounded-2xl bg-card text-brand ring-1 ring-line transition-colors group-hover:bg-brand group-hover:text-bg">
      <Icon name={category.icon} size={28} />
    </span>
    <span class="font-display text-5xl font-extrabold text-ink/10 transition-colors group-hover:text-brand/30" aria-hidden="true">
      {category.number}
    </span>
  </div>
  <h3 class="mt-6 text-3xl font-bold">{category.title}</h3>
  <p class="mt-3 text-sm text-muted">{category.summary}</p>
  <ul class="mt-5 flex flex-wrap gap-2">
    {category.items.map((item) => <li class="rounded-full bg-card/70 px-3 py-1 text-xs text-ink/85">{item}</li>)}
  </ul>
  <a
    href={`/servicos/${category.slug}`}
    class="mt-auto inline-flex items-center gap-2 pt-7 font-display text-base font-bold tracking-wider text-brand uppercase after:absolute after:inset-0 after:rounded-2xl"
  >
    Ver pacotes <span class="sr-only">de {category.title}</span>
    <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
  </a>
</article>
