---
/**
 * Botão flutuante do WhatsApp.
 * A mensagem muda conforme a origem do contato:
 * - padrão da página (prop `message`);
 * - seção visível na tela: qualquer elemento com `data-wa-message="..."`
 *   (ex.: seção de FAQ, de serviços) substitui a mensagem enquanto está visível.
 */
import Icon from './Icon.astro';
import { site } from '@/config/site';
import { whatsappLink } from '@/lib/whatsapp';

interface Props {
  message: string;
}
const { message } = Astro.props;
---

<a
  id="wa-float"
  href={whatsappLink(site.whatsappNumber, message)}
  data-default-message={message}
  data-number={site.whatsappNumber}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Conversar pelo WhatsApp"
  class="group fixed right-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-brand text-bg shadow-[0_10px_30px_-8px_rgb(139_224_122/0.7)] transition duration-300 ease-smooth hover:scale-105 active:scale-95 sm:right-6 sm:bottom-6"
>
  <Icon name="whatsapp" size={30} />
  <span
    class="pointer-events-none absolute right-full mr-3 hidden rounded-full bg-bg-2 px-3 py-1.5 text-sm font-medium whitespace-nowrap text-ink opacity-0 ring-1 ring-line transition group-hover:opacity-100 sm:block"
    >Fale comigo</span
  >
</a>

<script>
  import { whatsappLink } from '@/lib/whatsapp';

  const btn = document.getElementById('wa-float') as HTMLAnchorElement | null;
  const sections = document.querySelectorAll<HTMLElement>('[data-wa-message]');
  if (btn && sections.length && 'IntersectionObserver' in window) {
    const number = btn.dataset.number ?? '';
    const fallback = btn.dataset.defaultMessage ?? '';
    const visible = new Set<HTMLElement>();
    const update = () => {
      // Usa a última seção visível na ordem do documento.
      const current = [...sections].filter((s) => visible.has(s)).pop();
      btn.href = whatsappLink(number, current?.dataset.waMessage ?? fallback);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement)));
        update();
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
