---
/**
 * Layout do PAINEL PROFISSIONAL (área com login).
 * Menu lateral no computador e barra superior no celular.
 */
import '@/styles/global.css';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';

interface Props {
  title: string;
  /** Tela de login: sem menu. */
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

type Item = { href: string; label: string; icon: string; match: (p: string) => boolean; badge?: 'leads' | 'deliveries' | 'outreach' };
const groups: { title: string; items: Item[] }[] = [
  { title: '', items: [{ href: '/painel/', label: 'Início', icon: 'calendar', match: (p) => p === '/painel' }] },
  {
    title: 'Vendas',
    items: [
      { href: '/painel/pedidos/', label: 'Pedidos do site', icon: 'whatsapp', match: (p) => p.startsWith('/painel/pedidos'), badge: 'leads' },
      { href: '/painel/abordagem/', label: 'Fila de abordagem', icon: 'chat', match: (p) => p.startsWith('/painel/abordagem'), badge: 'outreach' },
      { href: '/painel/propostas/', label: 'Propostas', icon: 'check', match: (p) => p === '/painel/propostas' },
      { href: '/painel/propostas/nova/', label: 'Nova proposta', icon: 'plus', match: (p) => p.startsWith('/painel/propostas/nova') },
      { href: '/painel/clientes/', label: 'Clientes', icon: 'search', match: (p) => p.startsWith('/painel/clientes') },
    ],
  },
  {
    title: 'Trabalhos',
    items: [
      { href: '/painel/agenda/', label: 'Agenda', icon: 'calendar', match: (p) => p.startsWith('/painel/agenda') },
      { href: '/painel/entregas/', label: 'Entregas', icon: 'truck', match: (p) => p.startsWith('/painel/entregas'), badge: 'deliveries' },
    ],
  },
  {
    title: 'Loja',
    items: [
      { href: '/painel/eventos/', label: 'Eventos (venda de fotos)', icon: 'camera', match: (p) => p.startsWith('/painel/eventos') },
      { href: '/painel/vendas/', label: 'Vendas', icon: 'tag', match: (p) => p.startsWith('/painel/vendas') },
      { href: '/painel/relatorios/', label: 'Relatórios e MEI', icon: 'check', match: (p) => p.startsWith('/painel/relatorios') },
      { href: '/painel/marca-dagua/', label: "Marca d'água e proteção", icon: 'image', match: (p) => p.startsWith('/painel/marca-dagua') },
      { href: '/painel/rostos/', label: 'Reconhecimento facial', icon: 'search', match: (p) => p.startsWith('/painel/rostos') },
    ],
  },
  {
    title: 'Site',
    items: [
      { href: '/painel/site/precos/', label: 'Preços', icon: 'tag', match: (p) => p.startsWith('/painel/site/precos') },
      { href: '/painel/site/fotos/', label: 'Fotos', icon: 'camera', match: (p) => p.startsWith('/painel/site/fotos') },
    ],
  },
  {
    title: 'Ferramentas',
    items: [
      { href: '/painel/qrcodes/', label: 'QR Codes', icon: 'image', match: (p) => p.startsWith('/painel/qrcodes') },
      { href: '/painel/mensagens/', label: 'Mensagens', icon: 'chat', match: (p) => p.startsWith('/painel/mensagens') },
    ],
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#070A08" />
    <title>{title} · Painel {site.shortName}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-dvh bg-bg">
    {
      bare ? (
        <slot />
      ) : (
        <div class="lg:grid lg:min-h-dvh lg:grid-cols-[248px_1fr]">
          <!-- Menu lateral (computador) / barra superior (celular) -->
          <aside class="sticky top-0 z-40 border-b border-line bg-bg-2/95 backdrop-blur lg:h-dvh lg:overflow-y-auto lg:border-r lg:border-b-0">
            <div class="flex items-center justify-between gap-3 px-4 py-3 lg:block lg:px-5 lg:py-6">
              <a href="/painel/" class="block leading-none">
                <span class="font-display text-2xl font-extrabold tracking-wide">
                  {site.shortName}<span class="text-brand">.</span>
                </span>
                <span class="mt-1 block text-[10px] tracking-[0.25em] text-brand uppercase">Fotografia · painel</span>
              </a>
              <div class="ml-auto flex items-center gap-1 lg:hidden">
                <a href="/painel/pedidos/" class="relative grid size-10 place-items-center rounded-full text-muted hover:text-ink" aria-label="Pedidos novos">
                  <Icon name="bell" size={20} />
                  <span data-bell-dot hidden class="absolute top-2 right-2 size-2 rounded-full bg-brand shadow-[0_0_8px_var(--color-brand)]"></span>
                </a>
              </div>
              <button
                type="button"
                id="panel-menu-btn"
                class="grid size-10 place-items-center rounded-full border border-line lg:hidden"
                aria-controls="panel-nav"
                aria-expanded="false"
                aria-label="Abrir menu do painel"
              >
                <Icon name="menu" size={20} />
              </button>
            </div>
            <nav id="panel-nav" aria-label="Menu do painel" class="hidden px-3 pb-4 lg:block lg:px-3">
              <div class="space-y-4">
                {groups.map((g) => (
                  <div>
                    {g.title && <p class="px-3 pb-1 text-[10px] font-semibold tracking-[0.2em] text-muted/70 uppercase">{g.title}</p>}
                    <ul class="space-y-0.5">
                      {g.items.map((n) => (
                        <li>
                          <a
                            href={n.href}
                            aria-current={n.match(path) ? 'page' : undefined}
                            class="flex items-center gap-3 rounded-xl border border-transparent px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-card/50 hover:text-ink aria-[current=page]:border-brand/40 aria-[current=page]:bg-brand/10 aria-[current=page]:text-brand aria-[current=page]:shadow-[0_0_18px_-6px_var(--color-brand)]"
                          >
                            <Icon name={n.icon as 'calendar'} size={18} /> {n.label}
                            {n.badge && <span data-badge={n.badge} hidden class="ml-auto rounded-full px-2 py-0.5 text-[11px] font-bold text-bg" />}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <!-- Armazenamento das fotos (R2) -->
              <div data-storage class="mt-6 rounded-2xl border border-line bg-bg/60 p-3">
                <p class="flex items-center gap-2 text-xs font-semibold text-ink"><Icon name="database" size={16} class="text-brand" /> Armazenamento</p>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10"><div data-storage-bar class="h-full w-0 rounded-full bg-brand shadow-[0_0_10px_var(--color-brand)] transition-[width] duration-700"></div></div>
                <p class="mt-1.5 flex justify-between text-[11px] text-muted"><span data-storage-text>Calculando…</span><span data-storage-pct></span></p>
                <a href="https://dash.cloudflare.com/?to=/:account/r2/overview" target="_blank" rel="noopener noreferrer" class="mt-2.5 flex items-center justify-center gap-1.5 rounded-xl border border-brand/40 px-3 py-1.5 text-xs font-semibold text-brand hover:bg-brand/10">
                  <Icon name="bolt" size={14} /> Gerenciar plano
                </a>
              </div>
              <div class="mt-4 space-y-1 border-t border-line pt-4">
                <a href="/" target="_blank" rel="noopener" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-muted hover:text-ink">
                  <Icon name="external" size={18} /> Ver site público
                </a>
                <button type="button" data-logout class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm text-muted hover:text-ink">
                  <Icon name="close" size={18} /> Sair
                </button>
              </div>
            </nav>
          </aside>

          <div class="min-w-0">
            <!-- Barra superior: notificações e usuário (computador) -->
            <header class="hidden items-center justify-end gap-3 border-b border-line px-10 py-3 lg:flex">
              <a href="/painel/pedidos/" class="relative grid size-10 place-items-center rounded-full text-muted transition-colors hover:bg-card hover:text-ink" aria-label="Pedidos novos do site">
                <Icon name="bell" size={20} />
                <span data-bell-dot hidden class="absolute top-2 right-2.5 size-2 rounded-full bg-brand shadow-[0_0_8px_var(--color-brand)]"></span>
              </a>
              <div class="relative">
                <button type="button" data-user-btn aria-expanded="false" aria-haspopup="menu" class="flex items-center gap-2.5 rounded-full py-1 pr-2 pl-1 transition-colors hover:bg-card">
                  <span class="grid size-9 place-items-center rounded-full border border-line bg-card text-muted"><Icon name="user" size={18} /></span>
                  <span class="text-left leading-tight">
                    <span class="block text-sm font-semibold">{site.owner}</span>
                    <span class="block text-[11px] text-muted">Administrador</span>
                  </span>
                  <Icon name="chevron-down" size={16} class="text-muted" />
                </button>
                <div data-user-menu hidden role="menu" class="absolute right-0 z-50 mt-2 w-48 overflow-hidden rounded-xl border border-line bg-bg-2 py-1 shadow-xl">
                  <a role="menuitem" href="/" target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-2.5 text-sm text-muted hover:bg-card hover:text-ink"><Icon name="external" size={16} /> Ver site público</a>
                  <button role="menuitem" type="button" data-logout-top class="flex w-full items-center gap-2 px-4 py-2.5 text-left text-sm text-muted hover:bg-card hover:text-ink"><Icon name="close" size={16} /> Sair</button>
                </div>
              </div>
            </header>
            <main id="conteudo" class="min-w-0 px-4 py-8 sm:px-6 lg:px-10 lg:py-8">
              <slot />
            </main>
          </div>
        </div>
      )
    }

    <script>
      import { api, todayISO } from '@/lib/panel-api';
      import { buildQueue } from '@/lib/outreach';
      import { metaDiariaNovos } from '@/data/outreach';
      import { storageSummary } from '@/lib/events-dashboard';
      const btn = document.getElementById('panel-menu-btn');
      const nav = document.getElementById('panel-nav');
      btn?.addEventListener('click', () => {
        const open = nav!.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
      // Contadores no menu: pedidos novos e entregas atrasadas/vencendo hoje.
      const badge = (name: string, n: number, cls: string) => {
        const el = document.querySelector<HTMLElement>(`[data-badge="${name}"]`);
        if (!el) return;
        el.textContent = String(n);
        el.hidden = n === 0;
        el.classList.add(cls);
      };
      const refreshBadges = () => {
        api.leadCount().then(({ novo }) => badge('leads', novo, 'bg-brand')).catch(() => {});
        api.clients().then((clients) => {
          const q = buildQueue(clients, todayISO(), metaDiariaNovos);
          badge('outreach', q.followUps.length + q.fresh.length, 'bg-brand');
        }).catch(() => {});
        api.jobs().then((jobs) => {
          const today = todayISO();
          const due = jobs.filter((j) => j.kind === 'trabalho' && j.due_date && j.due_date <= today && ['agendado', 'fotografado', 'editando'].includes(j.status)).length;
          badge('deliveries', due, 'bg-red-400');
        }).catch(() => {});
      };
      refreshBadges();
      // As telas avisam quando algo muda (entrega marcada, pedido atendido…).
      window.addEventListener('venart:badges', refreshBadges);
      const logout = async () => {
        await api.logout().catch(() => {});
        location.href = '/painel/login/';
      };
      document.querySelector('[data-logout]')?.addEventListener('click', logout);
      document.querySelector('[data-logout-top]')?.addEventListener('click', logout);
      // Menu do usuário
      const userBtn = document.querySelector<HTMLElement>('[data-user-btn]');
      const userMenu = document.querySelector<HTMLElement>('[data-user-menu]');
      userBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        userMenu!.hidden = !userMenu!.hidden;
        userBtn.setAttribute('aria-expanded', String(!userMenu!.hidden));
      });
      document.addEventListener('click', () => { if (userMenu) userMenu.hidden = true; userBtn?.setAttribute('aria-expanded', 'false'); });
      // Sino: ponto verde quando há pedidos novos do site.
      api.leadCount().then(({ novo }) => document.querySelectorAll<HTMLElement>('[data-bell-dot]').forEach((d) => (d.hidden = !novo))).catch(() => {});
      // Armazenamento usado (R2)
      // (só nas telas com menu; a tela de login não tem)
      if (document.querySelector('[data-storage]'))
        api.storage().then((s) => {
          const sum = storageSummary(s.bytes, s.quota);
          document.querySelector<HTMLElement>('[data-storage-bar]')!.style.width = `${Math.max(sum.percent, 1)}%`;
          document.querySelector('[data-storage-text]')!.textContent = `${sum.used} de ${sum.quota}${s.partial ? '+' : ''}`;
          document.querySelector('[data-storage-pct]')!.textContent = `${sum.percent}%`;
        }).catch(() => { document.querySelector('[data-storage-text]')!.textContent = 'Indisponível'; });
    </script>
  </body>
</html>
