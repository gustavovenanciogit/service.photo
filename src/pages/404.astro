---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" noindex>
  <section class="container-site grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="font-display text-8xl font-extrabold text-brand">404</p>
      <h1 class="mt-2 text-5xl font-extrabold">Página não encontrada</h1>
      <p class="mt-4 text-muted">O endereço pode ter mudado. Volte ao início para continuar.</p>
      <a href="/" class="btn btn-primary mt-8">Voltar ao início</a>
    </div>
  </section>
</BaseLayout>
