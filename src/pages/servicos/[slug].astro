---
/**
 * Página de cada categoria: /servicos/<slug>
 * Gerada automaticamente a partir de src/data/categories.ts.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PricingCard from '@/components/PricingCard.astro';
import Icon from '@/components/Icon.astro';
import { categories, type Category } from '@/data/categories';
import { packagesByCategory } from '@/data/services';
import { site } from '@/config/site';
import { messages, whatsappLink } from '@/lib/whatsapp';

export const getStaticPaths = (() => categories.map((category) => ({ params: { slug: category.slug }, props: { category } }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
}
const { category } = Astro.props;
const items = packagesByCategory(category.slug);
const others = categories.filter((c) => c.slug !== category.slug);
---

<BaseLayout title={category.title} description={`${category.summary} Pacotes e valores em ${site.city}.`} waMessage={messages.category(category.title)}>
  <section class="py-14 lg:py-20">
    <div class="container-site">
      <nav aria-label="Você está em" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ink">Início</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#servicos" class="hover:text-ink">Serviços</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{category.title}</li>
        </ol>
      </nav>

      <div data-reveal class="mt-8 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl">
          <p class="eyebrow">Categoria {category.number}</p>
          <h1 class="mt-3 text-6xl font-extrabold sm:text-7xl">{category.title}</h1>
          <p class="mt-4 text-lg text-muted">{category.summary}</p>
        </div>
        <span class="hidden size-20 shrink-0 place-items-center rounded-3xl bg-card text-brand ring-1 ring-line md:grid">
          <Icon name={category.icon} size={40} />
        </span>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((pkg) => <PricingCard pkg={pkg} showCategory={false} />)}
      </div>
      {items.length === 0 && <p class="mt-12 text-muted">Pacotes desta categoria sob consulta.</p>}

      <div data-reveal class="mt-14 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappLink(site.whatsappNumber, messages.category(category.title))} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <Icon name="whatsapp" size={20} /> Falar sobre {category.title.toLowerCase()}
        </a>
        <a href={`/precos?categoria=${category.slug}`} class="btn btn-outline">Ver na tabela de preços</a>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-bg-2 py-16">
    <div class="container-site">
      <h2 class="text-4xl font-bold">Outros serviços</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {
          others.map((c) => (
            <li>
              <a href={`/servicos/${c.slug}`} class="card card-hover flex h-full items-center gap-3 p-4">
                <Icon name={c.icon} size={22} class="shrink-0 text-brand" />
                <span class="font-display text-lg font-bold tracking-wide uppercase">{c.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
