---
/**
 * PÁGINA PERMANENTE DO EVENTO — /eventos/<endereço-do-evento>
 * O servidor entrega esta mesma página para qualquer evento (com título e capa para compartilhar);
 * o conteúdo vem de /api/public/eventos/<endereço>.
 * - Antes da publicação: nome, data, local, capa (se enviada), "Fotografias em preparação",
 *   previsão (horário de Manaus) e contagem regressiva só se a previsão for válida e futura
 *   (nunca negativa). NENHUMA foto do evento e nenhum download.
 * - Publicado: "Fotografias disponíveis" + "Encontrar minhas fotos" → a galeria real (/e/<endereço>),
 *   com busca por selfie, privacidade, carrinho e cupons de sempre. Não existe outra galeria.
 * - O link nunca muda: o cartão (/cartao) pode passar a destacar outro evento a qualquer momento.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
---

<BaseLayout title="Fotos do evento" description="Acompanhe a publicação das fotos do evento." bare>
  <section class="min-h-dvh px-4 py-6 sm:py-10" data-evento>
    <div class="mx-auto w-full max-w-md">
      <nav class="flex items-center justify-between">
        <a href="/cartao" data-track="back_click" class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-muted hover:text-ink">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Voltar ao cartão
        </a>
        <span class="font-display text-xl font-extrabold tracking-wide text-ink">{site.shortName}<span class="text-brand">.</span></span>
      </nav>

      <p data-loading class="py-20 text-center text-muted">Carregando…</p>

      <div data-error hidden class="mt-10 rounded-2xl border border-line bg-bg-2 p-6 text-center">
        <h1 class="font-display text-3xl font-extrabold">Evento não encontrado</h1>
        <p class="mt-2 text-sm text-muted">Confira o link recebido ou volte ao cartão para ver o evento em destaque.</p>
        <a href="/cartao" class="btn btn-primary mt-6 w-full justify-center">Ir para o cartão</a>
      </div>

      <article data-content hidden class="mt-4 overflow-hidden rounded-2xl border border-line bg-bg-2">
        <p data-preview hidden class="bg-amber-400/15 px-4 py-2 text-xs font-semibold text-amber-200">
          Rascunho não anunciado: só você vê esta página (logado no painel). Ative-o no Cartão Digital para o público ver.
        </p>
        <img data-cover alt="" hidden class="aspect-[16/9] w-full object-cover" />
        <div class="space-y-4 p-5">
          <header>
            <h1 data-name class="font-display text-3xl leading-tight font-extrabold text-ink"></h1>
            <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
              <span data-date-wrap class="inline-flex items-center gap-1.5">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <span data-date></span>
              </span>
              <span data-loc-wrap class="inline-flex items-center gap-1.5">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span data-loc></span>
              </span>
            </p>
          </header>
          <p data-text hidden class="text-sm whitespace-pre-line text-ink/85"></p>

          <!-- Antes da publicação -->
          <div data-state="preparando" hidden class="space-y-4">
            <div class="rounded-xl border border-amber-300/40 bg-amber-400/10 p-4">
              <p class="text-base font-bold text-amber-200">Fotografias em preparação</p>
              <p data-forecast class="mt-1 text-sm text-ink/85"></p>
              <p data-passed hidden class="mt-1 text-sm text-ink/85">A previsão já passou, mas as fotos ainda estão sendo preparadas. Volte em breve.</p>
              <div data-countdown hidden class="mt-4 grid grid-cols-4 gap-2 text-center" role="timer" aria-live="off">
                <div class="rounded-lg bg-black/30 py-2"><p data-cd="days" class="font-display text-2xl font-extrabold tabular-nums">0</p><p class="text-[10px] tracking-wider text-muted uppercase">dias</p></div>
                <div class="rounded-lg bg-black/30 py-2"><p data-cd="hours" class="font-display text-2xl font-extrabold tabular-nums">00</p><p class="text-[10px] tracking-wider text-muted uppercase">horas</p></div>
                <div class="rounded-lg bg-black/30 py-2"><p data-cd="minutes" class="font-display text-2xl font-extrabold tabular-nums">00</p><p class="text-[10px] tracking-wider text-muted uppercase">min</p></div>
                <div class="rounded-lg bg-black/30 py-2"><p data-cd="seconds" class="font-display text-2xl font-extrabold tabular-nums">00</p><p class="text-[10px] tracking-wider text-muted uppercase">seg</p></div>
              </div>
            </div>
            <button type="button" data-check data-track="check_click" class="btn btn-primary min-h-13 w-full justify-center">Verificar se as fotos já estão disponíveis</button>
            <p data-check-msg class="text-center text-sm text-muted" aria-live="polite"></p>
          </div>

          <!-- Publicado -->
          <div data-state="disponivel" hidden class="space-y-4">
            <div class="rounded-xl border border-brand/40 bg-brand/10 p-4">
              <p class="flex items-center gap-2 text-base font-bold text-brand">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                Fotografias disponíveis
              </p>
              <p data-avail-info class="mt-1 text-sm text-ink/85"></p>
            </div>
            <a data-gallery data-track="gallery_click" href="#" class="btn btn-primary min-h-14 w-full justify-center text-base">Encontrar minhas fotos</a>
          </div>

          <!-- Venda encerrada -->
          <div data-state="encerrado" hidden class="rounded-xl border border-line bg-white/5 p-4">
            <p class="text-base font-bold">Vendas encerradas</p>
            <p class="mt-1 text-sm text-muted">O prazo de venda das fotos deste evento terminou. Se precisar de alguma foto, fale comigo pelo WhatsApp.</p>
          </div>
        </div>
      </article>

      <nav data-links hidden class="mt-5 flex flex-col gap-3">
        <a href="/cartao" class="btn btn-outline min-h-12 w-full justify-center">Voltar ao cartão</a>
        <a data-past hidden href="/eventos/" data-track="past_click" class="inline-flex min-h-11 items-center justify-center text-sm font-semibold text-muted hover:text-ink">Ver outros eventos →</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<script>
  import { countdown, forecastLabel, forecastStatus, formatDay, type TeaserState } from '@/lib/cartao';

  type Data = {
    event: { slug: string; name: string; date: string; location: string; state: TeaserState; forecast: string; text: string; cover: string; photo_count: number; face_search: boolean; face_only: boolean };
    show_past: boolean;
    preview: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-evento]')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const slug = decodeURIComponent(location.pathname.split('/').filter(Boolean)[1] ?? '').toLowerCase();
  let timer = 0;
  let autoChecked = false;

  /** Estatísticas (FUTURO): hoje não envia nada. */
  function track(_name: string) {}
  root.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
    if (a) track(a.dataset.track!);
  });

  const load = async () => {
    const r = await fetch(`/api/public/eventos/${encodeURIComponent(slug)}`, { headers: { Accept: 'application/json' }, cache: 'no-store' });
    if (r.status === 404) return null;
    if (!r.ok) throw new Error('falha');
    return (await r.json()) as Data;
  };

  function tick(forecast: string) {
    const c = countdown(forecast);
    if (!c) {
      clearInterval(timer);
      showForecast(forecast);
      // Chegou a hora prevista com a página aberta: confere uma vez sozinho.
      if (!autoChecked) {
        autoChecked = true;
        void check(true);
      }
      return;
    }
    $('[data-cd="days"]').textContent = String(c.days);
    $('[data-cd="hours"]').textContent = String(c.hours).padStart(2, '0');
    $('[data-cd="minutes"]').textContent = String(c.minutes).padStart(2, '0');
    $('[data-cd="seconds"]').textContent = String(c.seconds).padStart(2, '0');
  }

  function showForecast(forecast: string) {
    const fs = forecastStatus(forecast);
    $('[data-forecast]').textContent = fs === 'nenhuma' ? 'A previsão de publicação será informada em breve.' : `Previsão de publicação: ${forecastLabel(forecast)} (horário de Manaus).`;
    $('[data-passed]').hidden = fs !== 'passou';
    $('[data-countdown]').hidden = fs !== 'futura';
  }

  function render(d: Data) {
    const e = d.event;
    document.title = `${e.name} — Fotos | Venart`;
    $('[data-loading]').hidden = true;
    $('[data-content]').hidden = false;
    $('[data-links]').hidden = false;
    $('[data-preview]').hidden = !d.preview;
    $('[data-past]').hidden = !d.show_past;
    $('[data-name]').textContent = e.name;
    $('[data-date]').textContent = formatDay(e.date);
    $('[data-date-wrap]').hidden = !e.date;
    $('[data-loc]').textContent = e.location;
    $('[data-loc-wrap]').hidden = !e.location;
    $('[data-text]').textContent = e.text;
    $('[data-text]').hidden = !e.text;
    const img = $<HTMLImageElement>('[data-cover]');
    if (e.cover && img.getAttribute('src') !== e.cover) img.src = e.cover;
    img.hidden = !e.cover;
    root.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => (el.hidden = el.dataset.state !== e.state));
    clearInterval(timer);
    if (e.state === 'preparando') {
      showForecast(e.forecast);
      if (forecastStatus(e.forecast) === 'futura') {
        tick(e.forecast);
        timer = window.setInterval(() => tick(e.forecast), 1000);
      }
    } else if (e.state === 'disponivel') {
      $<HTMLAnchorElement>('[data-gallery]').href = `/e/${encodeURIComponent(e.slug)}`;
      const parts = [
        e.face_only ? 'Galeria privada: encontre as suas fotos com uma selfie.' : e.photo_count ? `${e.photo_count} foto${e.photo_count === 1 ? '' : 's'} publicada${e.photo_count === 1 ? '' : 's'}.` : '',
        e.face_search && !e.face_only ? 'Você pode procurar pelas suas fotos com uma selfie.' : '',
      ];
      $('[data-avail-info]').textContent = parts.filter(Boolean).join(' ');
    }
  }

  async function check(auto = false) {
    const btn = $<HTMLButtonElement>('[data-check]');
    const msg = $('[data-check-msg]');
    btn.disabled = true;
    msg.textContent = 'Verificando…';
    try {
      const d = await load();
      if (!d) throw new Error('falha');
      render(d);
      msg.textContent = d.event.state === 'preparando' ? (auto ? '' : 'Ainda não. As fotos continuam em preparação.') : '';
      if (d.event.state === 'disponivel') $('[data-gallery]').focus();
    } catch {
      msg.textContent = 'Não foi possível verificar agora. Tente de novo em instantes.';
    } finally {
      btn.disabled = false;
    }
  }
  $('[data-check]').addEventListener('click', () => void check());

  load()
    .then((d) => {
      if (!d) throw new Error('404');
      render(d);
      track('event_view');
    })
    .catch(() => {
      $('[data-loading]').hidden = true;
      $('[data-error]').hidden = false;
      $('[data-links]').hidden = true;
    });
</script>
