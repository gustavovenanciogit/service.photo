---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FAQ from '@/components/FAQ.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { messages, whatsappLink } from '@/lib/whatsapp';
---

<BaseLayout title="Dúvidas frequentes" description="Respostas sobre contratação, entrega das fotos, horas adicionais e atendimento." waMessage={messages.faq()}>
  <section class="py-14 lg:py-20">
    <div class="container-site max-w-4xl">
      <SectionHeading as="h1" eyebrow="FAQ" title="Dúvidas" highlight="frequentes" intro="Não encontrou sua resposta? Me chame no WhatsApp." />
      <div class="mt-10" data-reveal><FAQ /></div>
      <div class="mt-10 text-center" data-reveal>
        <a href={whatsappLink(site.whatsappNumber, messages.faq())} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <Icon name="whatsapp" size={20} /> Tirar outra dúvida
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
