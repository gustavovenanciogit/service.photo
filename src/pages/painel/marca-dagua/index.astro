---
/**
 * MARCA D'ÁGUA E PROTEÇÃO — /painel/marca-dagua/
 * 8 modelos com ajustes individuais, visualização em tempo real (mesmo motor do envio das fotos),
 * modelo padrão, modelo por galeria e proteções das prévias públicas.
 */
import { getImage } from 'astro:assets';
import PanelLayout from '@/layouts/PanelLayout.astro';
import { allPortfolioFiles } from '@/lib/images';

// Fotos reais de exemplo (claras, escuras, verticais, horizontais, com detalhes).
const wanted = [
  { file: 'artes-marciais/jiu-jitsu-queda.jpg', label: 'Escura · vertical' },
  { file: 'esportes/corredora-arco.jpg', label: 'Clara · vertical' },
  { file: 'eventos-sociais/cha-revelacao-confete.jpg', label: 'Detalhes · horizontal' },
  { file: 'eventos-sociais/cha-revelacao-vela.jpg', label: 'Clara · horizontal' },
  { file: 'ensaios/ensaio-estudio-retrato.jpg', label: 'Estúdio · vertical' },
];
const samples = (
  await Promise.all(
    wanted.map(async (s) => {
      const src = allPortfolioFiles[s.file];
      if (!src) return null;
      const k = Math.min(1, 1600 / Math.max(src.width, src.height));
      const img = await getImage({ src, width: Math.round(src.width * k), format: 'jpg', quality: 90 });
      return { url: img.src, label: s.label };
    }),
  )
).filter(Boolean);
const field = 'w-full rounded-xl border border-line bg-bg px-3 py-2 text-sm text-ink focus:border-brand focus:outline-none';
---

<PanelLayout title="Marca d'água e proteção">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Loja de fotos</p>
      <h1 class="mt-1 text-4xl font-extrabold sm:text-5xl">Marca d'água e proteção</h1>
      <p class="mt-2 max-w-3xl text-muted">
        A marca d'água é gravada nos pixels das prévias quando as fotos são enviadas — a foto original fica guardada sem alteração e só sai para quem
        comprou. Nenhuma marca impede print de tela ou remoção por IA: o objetivo é dificultar o uso indevido.
      </p>
    </div>
    <p data-dirty hidden class="rounded-full bg-amber-400/15 px-3 py-1 text-xs font-semibold text-amber-200">Alterações não salvas</p>
  </div>

  <div role="tablist" aria-label="Seções" class="mt-6 inline-flex rounded-full border border-line bg-bg-2 p-1">
    <button role="tab" type="button" data-tab="marca" aria-selected="true" class="rounded-full px-5 py-2 text-sm font-semibold aria-selected:bg-brand aria-selected:text-bg">Marca d'água</button>
    <button role="tab" type="button" data-tab="protecao" aria-selected="false" class="rounded-full px-5 py-2 text-sm font-semibold aria-selected:bg-brand aria-selected:text-bg">Proteção</button>
  </div>

  <p data-loading class="mt-8 text-muted">Carregando…</p>

  <div data-samples data-list={JSON.stringify(samples)} hidden></div>

  <!-- ───────── ABA MARCA D'ÁGUA ───────── -->
  <section data-panel="marca" hidden>
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="text-sm text-muted">Foto de exemplo:</span>
      <div data-sample-btns class="flex flex-wrap gap-2"></div>
      <label class="btn btn-outline min-h-9 cursor-pointer px-3 text-xs">
        Testar com uma foto sua <input data-test-file type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" />
      </label>
      <span class="text-xs text-muted">(fica só no seu aparelho, não é enviada)</span>
    </div>

    <ul data-cards class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4"></ul>

    <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_380px] xl:items-start">
      <!-- Visualização -->
      <section class="card p-4 sm:p-5" aria-labelledby="pv-title">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="pv-title" class="text-2xl font-bold"><span data-pv-name></span></h2>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span data-busy class="text-muted" aria-live="polite"></span>
            <button type="button" data-zoom class="btn btn-outline min-h-9 px-3 text-xs" aria-pressed="false">Zoom 100%</button>
          </div>
        </div>
        <div data-stage class="relative mt-3 max-h-[75vh] overflow-auto rounded-xl bg-black">
          <div data-stage-inner class="relative mx-auto w-fit">
            <canvas data-after class="block max-h-[70vh] w-auto max-w-full"></canvas>
            <canvas data-before class="pointer-events-none absolute inset-0 block h-full w-full" style="clip-path: inset(0 100% 0 0)"></canvas>
            <div data-divider class="pointer-events-none absolute inset-y-0 w-0.5 bg-brand" style="left: 0%" hidden></div>
          </div>
        </div>
        <label class="mt-3 flex items-center gap-3 text-sm">
          <span class="shrink-0 text-muted">Antes / depois</span>
          <input data-compare type="range" min="0" max="100" value="0" class="w-full accent-[var(--color-brand)]" aria-label="Comparar com e sem marca d'água" />
        </label>
        <p class="mt-2 text-xs text-muted">Mostrado no tamanho real da prévia pública (<span data-pv-size></span>), com a mesma marca, desfoque e qualidade que vão para a galeria.</p>
      </section>

      <!-- Ajustes -->
      <section class="card p-4 sm:p-5" aria-labelledby="adj-title">
        <h2 id="adj-title" class="text-2xl font-bold">Ajustes do modelo</h2>
        <p data-model-desc class="mt-1 text-sm text-muted"></p>

        <fieldset class="mt-4">
          <legend class="text-sm font-medium">Intensidade</legend>
          <div data-intensity class="mt-2 grid grid-cols-4 gap-1 rounded-xl border border-line bg-bg p-1"></div>
        </fieldset>

        <div data-sliders class="mt-4 space-y-3"></div>

        <fieldset class="mt-4">
          <legend class="text-sm font-medium">Cor</legend>
          <div class="mt-2 flex flex-wrap items-center gap-3 text-sm">
            <label class="flex items-center gap-1.5"><input type="radio" name="color" value="auto" class="accent-[var(--color-brand)]" /> Automática</label>
            <label class="flex items-center gap-1.5"><input type="radio" name="color" value="white" class="accent-[var(--color-brand)]" /> Branca</label>
            <label class="flex items-center gap-1.5"><input type="radio" name="color" value="black" class="accent-[var(--color-brand)]" /> Preta</label>
            <label class="flex items-center gap-1.5"><input type="radio" name="color" value="custom" class="accent-[var(--color-brand)]" /> Personalizada</label>
            <input data-custom-color type="color" aria-label="Cor personalizada" class="h-8 w-12 rounded border border-line bg-bg" />
          </div>
          <p class="mt-1 text-xs text-muted">Todas as marcas têm contorno contrastante, para aparecer em fundos claros e escuros.</p>
        </fieldset>

        <label class="mt-4 block text-sm">
          <span class="font-medium">Texto da marca</span>
          <input data-text maxlength="30" class={`${field} mt-1.5`} />
        </label>
        <label class="mt-3 flex items-center gap-2 text-sm">
          <input data-use-logo type="checkbox" class="size-4 accent-[var(--color-brand)]" /> Usar logotipo/símbolo junto com o texto
        </label>

        <div class="mt-5 grid gap-2 sm:grid-cols-2">
          <button type="button" data-save class="btn btn-outline min-h-11 text-sm">Salvar ajustes</button>
          <button type="button" data-apply class="btn btn-primary min-h-11 text-sm">Aplicar como padrão</button>
          <button type="button" data-reset class="btn min-h-10 text-xs text-muted hover:text-ink sm:col-span-2">Restaurar padrão deste modelo</button>
        </div>
      </section>
    </div>

    <!-- Logotipo -->
    <section class="card mt-6 p-4 sm:p-5" aria-labelledby="logo-title">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 id="logo-title" class="text-2xl font-bold">Logotipo da marca d'água</h2>
          <p data-logo-status class="mt-1 text-sm text-muted"></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <label class="btn btn-outline min-h-10 cursor-pointer px-4 text-sm">
            Enviar PNG ou SVG <input data-logo-file type="file" accept="image/png,image/svg+xml" class="sr-only" />
          </label>
          <button type="button" data-logo-remove class="btn min-h-10 px-4 text-sm text-red-300 hover:bg-red-500/10" hidden>Usar o símbolo padrão</button>
        </div>
      </div>
      <p class="mt-2 text-xs text-muted">Use um logotipo com fundo transparente. Ele é convertido em PNG no seu aparelho (SVGs não são guardados) e recolorido conforme a cor escolhida.</p>
    </section>
  </section>

  <!-- ───────── ABA PROTEÇÃO ───────── -->
  <section data-panel="protecao" hidden>
    <div class="mt-6 grid gap-6 xl:grid-cols-2">
      <section class="card p-5" aria-labelledby="pa-title">
        <h2 id="pa-title" class="text-2xl font-bold">Pré-visualização reduzida</h2>
        <p class="mt-1 text-sm text-muted">Tamanho máximo (maior lado) da foto que os visitantes recebem. O servidor recusa prévias maiores.</p>
        <div class="mt-3 flex flex-wrap gap-4 text-sm">
          {[800, 1200, 1600].map((v) => <label class="flex items-center gap-1.5"><input type="radio" name="maxSize" value={v} class="accent-[var(--color-brand)]" /> {v} px</label>)}
        </div>
      </section>

      <section class="card p-5" aria-labelledby="pb-title">
        <h2 id="pb-title" class="text-2xl font-bold">Desfoque</h2>
        <p class="mt-1 text-sm text-muted">Aplicado só à prévia pública, nunca ao original.</p>
        <div class="mt-3 flex flex-wrap gap-4 text-sm">
          {[['none', 'Nenhum'], ['leve', 'Leve'], ['moderado', 'Moderado'], ['forte', 'Forte']].map(([v, l]) => <label class="flex items-center gap-1.5"><input type="radio" name="blur" value={v} class="accent-[var(--color-brand)]" /> {l}</label>)}
        </div>
        <div class="mt-3 flex flex-wrap gap-4 text-sm">
          <label class="flex items-center gap-1.5"><input type="radio" name="blurRegion" value="all" class="accent-[var(--color-brand)]" /> Foto inteira</label>
          <label class="flex items-center gap-1.5"><input type="radio" name="blurRegion" value="edges" class="accent-[var(--color-brand)]" /> Só as bordas (centro nítido)</label>
        </div>
      </section>

      <section class="card p-5" aria-labelledby="pc-title">
        <h2 id="pc-title" class="text-2xl font-bold">Controle de downloads</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted">
          <li>Originais ficam em armazenamento privado, sem endereço público.</li>
          <li>Os visitantes só recebem prévia e miniatura com marca d'água, e só de galerias publicadas.</li>
          <li>O download do original exige pagamento confirmado no servidor e um link secreto do pedido, que expira no fim do prazo de download.</li>
          <li>Limite de downloads por pedido (5 por foto + 30 a cada 24 h) contra abuso.</li>
          <li>Não há bloqueio de "clique direito": ele não protege nada de verdade.</li>
        </ul>
        <p class="mt-2 text-xs text-muted">Esses controles já funcionam no servidor e não precisam de ajuste.</p>
      </section>

      <section class="card p-5" aria-labelledby="pd-title">
        <h2 id="pd-title" class="text-2xl font-bold">Marca d'água por galeria</h2>
        <label class="mt-3 block text-sm">
          <span class="font-medium">Modelo padrão (novas galerias e galerias sem modelo próprio)</span>
          <select data-default-model class={`${field} mt-1.5`}></select>
        </label>
        <ul data-events class="mt-4 max-h-80 space-y-2 overflow-auto"></ul>
        <p class="mt-2 text-xs text-muted">Depois de mudar o modelo de uma galeria que já tem fotos, abra o evento e use "Reaplicar marca d'água".</p>
      </section>
    </div>
    <div class="mt-6 flex justify-end">
      <button type="button" data-save-prot class="btn btn-primary min-h-11 px-6">Salvar proteção</button>
    </div>
  </section>
</PanelLayout>

<script>
  import { api, h, toast } from '@/lib/panel-api';
  import { FONT, loadFonts, loadLogo, renderPreview } from '@/lib/watermark';
  import {
    DEFAULT_SETTINGS, INTENSITY, MODEL_IDS, MODELS, parseSettings, ratings,
    type Intensity, type ModelId, type ModelParams, type WatermarkSettings,
  } from '@/lib/watermark-models';
  import type { RenderAssets } from '@/lib/watermark-render';
  import type { EventRecord } from '@/lib/events';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement = HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];
  const samples = JSON.parse($('[data-samples]').dataset.list ?? '[]') as { url: string; label: string }[];
  const SEED = 'amostra-venart';

  let saved: WatermarkSettings; // como está no servidor
  let draft: WatermarkSettings; // o que está na tela
  let current: ModelId = 8; // modelo em edição
  let img: ImageBitmap | null = null;
  let assets: RenderAssets = { logo: null, font: FONT };
  let events: EventRecord[] = [];
  const clone = <T,>(v: T): T => JSON.parse(JSON.stringify(v)) as T;
  const isDirty = () => JSON.stringify(draft) !== JSON.stringify(saved);
  const markDirty = () => { $('[data-dirty]').hidden = !isDirty(); };
  window.addEventListener('beforeunload', (e) => { if (draft && isDirty()) e.preventDefault(); });

  // ───────── Abas ─────────
  $$('[data-tab]').forEach((b) =>
    b.addEventListener('click', () => {
      $$('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      $$('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
      if (b.dataset.tab === 'marca') schedule(true);
    }),
  );

  // ───────── Fotos de exemplo ─────────
  async function loadSample(url: string | Blob) {
    const blob = typeof url === 'string' ? await (await fetch(url)).blob() : url;
    img?.close();
    img = await createImageBitmap(blob, { imageOrientation: 'from-image' });
    schedule(true);
  }
  samples.forEach((s, i) => {
    const b = h('button', 'btn btn-outline min-h-9 px-3 text-xs aria-pressed:border-brand aria-pressed:text-brand', s.label);
    b.setAttribute('type', 'button');
    b.setAttribute('aria-pressed', String(i === 0));
    b.addEventListener('click', () => {
      $$('[data-sample-btns] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      loadSample(s.url).catch(() => toast('Não foi possível abrir a foto.', 'error'));
    });
    $('[data-sample-btns]').append(b);
  });
  $<HTMLInputElement>('[data-test-file]').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    $$('[data-sample-btns] button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    loadSample(f).catch(() => toast('Não foi possível abrir essa imagem.', 'error'));
  });

  // ───────── Cartões dos modelos ─────────
  const dots = (n: number, label: string) => {
    const wrap = h('span', 'flex items-center gap-1');
    wrap.setAttribute('aria-label', `${label}: ${n} de 5`);
    wrap.setAttribute('role', 'img');
    for (let i = 1; i <= 5; i++) wrap.append(h('span', `inline-block h-1.5 w-3 rounded-full ${i <= n ? 'bg-brand' : 'bg-white/15'}`));
    return wrap;
  };
  function buildCards() {
    $('[data-cards]').replaceChildren(
      ...MODEL_IDS.map((id) => {
        const li = h('li', 'card overflow-hidden transition-shadow');
        li.dataset.card = String(id);
        const c = document.createElement('canvas');
        c.className = 'aspect-[3/2] w-full bg-black object-cover';
        c.dataset.thumb = String(id);
        const body = h('div', 'space-y-1.5 p-3');
        const top = h('div', 'flex items-center justify-between gap-2');
        top.append(h('p', 'text-sm font-bold leading-tight', `${id}. ${MODELS[id].name}`));
        const badge = h('span', 'hidden shrink-0 rounded-full bg-brand px-2 py-0.5 text-[10px] font-bold text-bg', 'Padrão');
        badge.dataset.badge = String(id);
        top.append(badge);
        const r1 = h('div', 'flex items-center justify-between text-[11px] text-muted');
        r1.append(h('span', '', 'Visibilidade'), h('span', '', ''));
        r1.dataset.vis = String(id);
        const r2 = h('div', 'flex items-center justify-between text-[11px] text-muted');
        r2.append(h('span', '', 'Proteção'), h('span', '', ''));
        r2.dataset.prot = String(id);
        const sel = h('button', 'btn btn-outline min-h-8 w-full px-2 text-xs', 'Selecionar');
        sel.setAttribute('type', 'button');
        sel.addEventListener('click', () => select(id));
        body.append(top, r1, r2, sel);
        li.append(c, body);
        return li;
      }),
    );
  }
  function paintCards() {
    for (const id of MODEL_IDS) {
      const r = ratings(id, draft.models[id]);
      const vis = document.querySelector(`[data-vis="${id}"]`)!;
      vis.lastElementChild!.replaceWith(dots(r.visibility, 'Visibilidade'));
      const prot = document.querySelector(`[data-prot="${id}"]`)!;
      prot.lastElementChild!.replaceWith(dots(r.protection, 'Proteção'));
      document.querySelector<HTMLElement>(`[data-badge="${id}"]`)!.classList.toggle('hidden', draft.defaultModel !== id);
      const card = document.querySelector<HTMLElement>(`[data-card="${id}"]`)!;
      card.classList.toggle('ring-2', current === id);
      card.classList.toggle('ring-brand', current === id);
      const btn = card.querySelector('button')!;
      btn.textContent = current === id ? 'Editando' : 'Selecionar';
      btn.setAttribute('aria-pressed', String(current === id));
    }
  }
  function renderThumbs(only?: ModelId) {
    if (!img) return;
    for (const id of only ? [only] : MODEL_IDS) {
      const c = document.querySelector<HTMLCanvasElement>(`[data-thumb="${id}"]`);
      if (c) renderPreview(c, img, 520, { model: id, params: draft.models[id], protection: draft.protection, assets }, SEED);
    }
  }

  // ───────── Visualização principal ─────────
  let pending = false;
  let all = false;
  function schedule(everything = false) {
    all ||= everything;
    if (pending) return;
    pending = true;
    $('[data-busy]').textContent = 'Processando…';
    requestAnimationFrame(() => {
      pending = false;
      if (!img || !draft) return;
      const t0 = performance.now();
      const job = { model: current, params: draft.models[current], protection: draft.protection, assets };
      const after = renderPreview($<HTMLCanvasElement>('[data-after]'), img, draft.protection.maxSize, job, SEED);
      renderPreview($<HTMLCanvasElement>('[data-before]'), img, draft.protection.maxSize, job, SEED, { watermark: false });
      $('[data-pv-size]').textContent = `${after.width} × ${after.height} px`;
      renderThumbs(all ? undefined : current);
      all = false;
      paintCards();
      $('[data-busy]').textContent = `Atualizado em ${Math.round(performance.now() - t0)} ms`;
    });
  }

  const compare = $<HTMLInputElement>('[data-compare]');
  compare.addEventListener('input', () => {
    const v = Number(compare.value);
    $('[data-before]').style.clipPath = `inset(0 ${100 - v}% 0 0)`;
    $('[data-divider]').style.left = `${v}%`;
    $('[data-divider]').hidden = v === 0 || v === 100;
  });
  $('[data-zoom]').addEventListener('click', () => {
    const on = $('[data-zoom]').getAttribute('aria-pressed') !== 'true';
    $('[data-zoom]').setAttribute('aria-pressed', String(on));
    $('[data-zoom]').textContent = on ? 'Ajustar à tela' : 'Zoom 100%';
    for (const c of $$<HTMLCanvasElement>('[data-stage] canvas')) {
      if (c.dataset.before !== undefined) continue;
      c.classList.toggle('max-h-[70vh]', !on);
      c.classList.toggle('max-w-full', !on);
    }
  });

  // ───────── Controles ─────────
  const SLIDERS: { key: keyof ModelParams; label: string; min: number; max: number; step: number; unit: string; scale?: number }[] = [
    { key: 'opacity', label: 'Opacidade', min: 5, max: 90, step: 1, unit: '%', scale: 100 },
    { key: 'size', label: 'Tamanho', min: 3, max: 60, step: 1, unit: '% do lado menor' },
    { key: 'density', label: 'Densidade', min: 1, max: 10, step: 1, unit: '' },
    { key: 'spacing', label: 'Espaçamento', min: 8, max: 60, step: 1, unit: '%' },
    { key: 'rotation', label: 'Rotação', min: -90, max: 90, step: 1, unit: '°' },
    { key: 'thickness', label: 'Espessura das faixas', min: 3, max: 30, step: 1, unit: '%' },
    { key: 'offsetX', label: 'Posição horizontal', min: -25, max: 25, step: 1, unit: '%' },
    { key: 'offsetY', label: 'Posição vertical', min: -25, max: 25, step: 1, unit: '%' },
  ];
  function setParam<K extends keyof ModelParams>(k: K, v: ModelParams[K]) {
    draft.models[current] = { ...draft.models[current], [k]: v };
    markDirty();
    schedule();
  }
  function buildControls() {
    const p = draft.models[current];
    const uses = MODELS[current].uses;
    $('[data-model-desc]').textContent = MODELS[current].description;
    $('[data-pv-name]').textContent = `Modelo ${current}: ${MODELS[current].name}`;
    $('[data-intensity]').replaceChildren(
      ...(Object.keys(INTENSITY) as Intensity[]).map((k) => {
        const b = h('button', 'rounded-lg px-2 py-1.5 text-xs font-semibold aria-pressed:bg-brand aria-pressed:text-bg', INTENSITY[k].label);
        b.setAttribute('type', 'button');
        b.setAttribute('aria-pressed', String(p.intensity === k));
        b.addEventListener('click', () => { setParam('intensity', k); buildControls(); });
        return b;
      }),
    );
    $('[data-sliders]').replaceChildren(
      ...SLIDERS.filter((s) => uses.includes(s.key)).map((s) => {
        const scale = s.scale ?? 1;
        const value = Math.round((p[s.key] as number) * scale);
        const row = h('div', '');
        const head = h('div', 'flex items-center justify-between gap-2 text-sm');
        const id = `sl-${s.key}`;
        const lab = h('label', 'font-medium', s.label);
        lab.setAttribute('for', id);
        const num = document.createElement('input');
        num.type = 'number';
        num.min = String(s.min);
        num.max = String(s.max);
        num.step = String(s.step);
        num.value = String(value);
        num.className = 'w-20 rounded-lg border border-line bg-bg px-2 py-1 text-right text-sm';
        num.setAttribute('aria-label', `${s.label} (${s.unit || 'valor'})`);
        const unit = h('span', 'text-xs text-muted', s.unit);
        const right = h('span', 'flex items-center gap-1.5');
        right.append(num, unit);
        head.append(lab, right);
        const range = document.createElement('input');
        range.type = 'range';
        range.id = id;
        range.min = String(s.min);
        range.max = String(s.max);
        range.step = String(s.step);
        range.value = String(value);
        range.className = 'mt-1 w-full accent-[var(--color-brand)]';
        const apply = (raw: string) => {
          const v = Math.min(s.max, Math.max(s.min, Number(raw)));
          if (!Number.isFinite(v)) return;
          range.value = num.value = String(v);
          setParam(s.key, (v / scale) as never);
        };
        range.addEventListener('input', () => apply(range.value));
        num.addEventListener('change', () => apply(num.value));
        row.append(head, range);
        return row;
      }),
    );
    $$<HTMLInputElement>('input[name=color]').forEach((r) => (r.checked = r.value === p.color));
    $<HTMLInputElement>('[data-custom-color]').value = p.customColor;
    $<HTMLInputElement>('[data-text]').value = p.text;
    $<HTMLInputElement>('[data-use-logo]').checked = p.useLogo;
  }
  $$<HTMLInputElement>('input[name=color]').forEach((r) => r.addEventListener('change', () => setParam('color', r.value as ModelParams['color'])));
  $<HTMLInputElement>('[data-custom-color]').addEventListener('input', (e) => {
    setParam('customColor', (e.target as HTMLInputElement).value);
    if (draft.models[current].color !== 'custom') { setParam('color', 'custom'); buildControls(); }
  });
  $<HTMLInputElement>('[data-text]').addEventListener('input', (e) => setParam('text', (e.target as HTMLInputElement).value.slice(0, 30)));
  $<HTMLInputElement>('[data-use-logo]').addEventListener('change', (e) => setParam('useLogo', (e.target as HTMLInputElement).checked));

  function select(id: ModelId) {
    current = id;
    buildControls();
    schedule();
  }

  // ───────── Salvar ─────────
  async function persist(msg: string) {
    const btns = $$<HTMLButtonElement>('[data-save], [data-apply], [data-save-prot]');
    btns.forEach((b) => (b.disabled = true));
    try {
      saved = await api.saveWatermarkSettings(parseSettings(draft));
      draft = clone(saved);
      buildControls();
      paintProtection();
      markDirty();
      schedule(true);
      toast(msg);
    } catch (e) {
      toast((e as Error).message, 'error');
    } finally {
      btns.forEach((b) => (b.disabled = false));
    }
  }
  $('[data-save]').addEventListener('click', () => persist('Ajustes salvos.'));
  $('[data-apply]').addEventListener('click', () => {
    draft.defaultModel = current;
    persist(`Modelo ${current} aplicado como padrão. As próximas fotos enviadas já saem com ele.`);
  });
  $('[data-reset]').addEventListener('click', () => {
    if (!confirm(`Voltar o modelo ${current} para os ajustes originais?`)) return;
    draft.models[current] = { ...DEFAULT_SETTINGS.models[current] };
    buildControls();
    markDirty();
    schedule();
  });

  // ───────── Logotipo ─────────
  function paintLogo() {
    $('[data-logo-status]').textContent = saved.logoVersion
      ? `Logotipo próprio enviado em ${new Date(saved.logoVersion).toLocaleDateString('pt-BR')}.`
      : 'Usando o símbolo padrão da Venart (o mesmo do ícone do site).';
    $('[data-logo-remove]').hidden = !saved.logoVersion;
  }
  /** Converte PNG/SVG em PNG (máx. 1024 px) no navegador — o SVG nunca é enviado. */
  async function toPng(file: File) {
    const url = URL.createObjectURL(file);
    try {
      const el = new Image();
      el.decoding = 'async';
      el.src = url;
      await el.decode();
      const w0 = el.naturalWidth || 1024;
      const h0 = el.naturalHeight || 1024;
      const k = Math.min(1, 1024 / Math.max(w0, h0)) || 1;
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(w0 * k));
      c.height = Math.max(1, Math.round(h0 * k));
      c.getContext('2d')!.drawImage(el, 0, 0, c.width, c.height);
      return await new Promise<Blob>((res, rej) => c.toBlob((b) => (b ? res(b) : rej(new Error('Falha ao converter.'))), 'image/png'));
    } finally {
      URL.revokeObjectURL(url);
    }
  }
  $<HTMLInputElement>('[data-logo-file]').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    input.value = '';
    if (!f) return;
    if (!['image/png', 'image/svg+xml'].includes(f.type)) return toast('Envie PNG ou SVG.', 'error');
    if (f.size > 2_000_000) return toast('Arquivo grande demais (máx. 2 MB).', 'error');
    try {
      const png = await toPng(f);
      const s = await api.uploadWatermarkLogo(png);
      saved.logoVersion = draft.logoVersion = s.logoVersion;
      assets = { logo: await loadLogo(s), font: FONT };
      paintLogo();
      schedule(true);
      toast('Logotipo enviado. Ele já aparece nos modelos.');
    } catch (err) { toast((err as Error).message, 'error'); }
  });
  $('[data-logo-remove]').addEventListener('click', async () => {
    if (!confirm('Voltar para o símbolo padrão da Venart?')) return;
    try {
      const s = await api.deleteWatermarkLogo();
      saved.logoVersion = draft.logoVersion = s.logoVersion;
      assets = { logo: null, font: FONT };
      paintLogo();
      schedule(true);
    } catch (err) { toast((err as Error).message, 'error'); }
  });

  // ───────── Proteção ─────────
  function paintProtection() {
    $$<HTMLInputElement>('input[name=maxSize]').forEach((r) => (r.checked = Number(r.value) === draft.protection.maxSize));
    $$<HTMLInputElement>('input[name=blur]').forEach((r) => (r.checked = r.value === draft.protection.blur));
    $$<HTMLInputElement>('input[name=blurRegion]').forEach((r) => (r.checked = r.value === draft.protection.blurRegion));
    const sel = $<HTMLSelectElement>('[data-default-model]');
    sel.replaceChildren(...MODEL_IDS.map((m) => new Option(`Modelo ${m}: ${MODELS[m].name}`, String(m))));
    sel.value = String(draft.defaultModel);
    $('[data-events]').replaceChildren(
      ...(events.length
        ? events.map((ev) => {
            const li = h('li', 'flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line bg-bg p-3 text-sm');
            li.append(h('span', 'min-w-0 flex-1 truncate font-semibold', ev.name));
            const s = document.createElement('select');
            s.className = 'rounded-lg border border-line bg-bg-2 px-2 py-1.5 text-xs';
            s.setAttribute('aria-label', `Marca d'água de ${ev.name}`);
            s.append(new Option('Padrão', '0'), ...MODEL_IDS.map((m) => new Option(`Modelo ${m}`, String(m))));
            s.value = String(ev.watermark_model || 0);
            s.addEventListener('change', async () => {
              try {
                const up = await api.updateEvent(ev.id, { ...ev, watermark_model: Number(s.value) });
                events = events.map((x) => (x.id === up.id ? up : x));
                toast(`"${ev.name}" agora usa ${s.value === '0' ? 'o modelo padrão' : `o modelo ${s.value}`}.`);
              } catch (e) { toast((e as Error).message, 'error'); s.value = String(ev.watermark_model || 0); }
            });
            li.append(s);
            return li;
          })
        : [h('li', 'text-sm text-muted', 'Nenhum evento ainda.')]),
    );
  }
  $$<HTMLInputElement>('input[name=maxSize]').forEach((r) => r.addEventListener('change', () => { draft.protection.maxSize = Number(r.value) as 800; markDirty(); }));
  $$<HTMLInputElement>('input[name=blur]').forEach((r) => r.addEventListener('change', () => { draft.protection.blur = r.value as 'none'; markDirty(); }));
  $$<HTMLInputElement>('input[name=blurRegion]').forEach((r) => r.addEventListener('change', () => { draft.protection.blurRegion = r.value as 'all'; markDirty(); }));
  $<HTMLSelectElement>('[data-default-model]').addEventListener('change', (e) => { draft.defaultModel = Number((e.target as HTMLSelectElement).value) as ModelId; markDirty(); });
  $('[data-save-prot]').addEventListener('click', () => persist('Proteção salva. Vale para as próximas fotos; use "Reaplicar" nos eventos já enviados.'));

  // ───────── Início ─────────
  (async () => {
    try {
      const [s, evs] = await Promise.all([api.watermarkSettings(), api.events(), loadFonts()]);
      saved = s;
      draft = clone(s);
      events = evs;
      current = s.defaultModel;
      assets = { logo: await loadLogo(s), font: FONT };
      buildCards();
      buildControls();
      paintLogo();
      paintProtection();
      $('[data-panel="marca"]').hidden = false;
      if (samples[0]) await loadSample(samples[0].url);
    } catch (e) {
      toast((e as Error).message, 'error');
    } finally {
      $('[data-loading]').hidden = true;
    }
  })();
</script>
