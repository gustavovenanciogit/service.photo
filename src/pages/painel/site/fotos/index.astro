---
/**
 * EDITAR FOTOS — /painel/site/fotos/
 * Envia fotos novas, edita legenda/ordem, oculta, exclui e escolhe o mosaico do topo.
 * Tudo é gravado num único commit no GitHub; a Cloudflare publica em 1 a 2 minutos.
 */
import { getImage } from 'astro:assets';
import PanelLayout from '@/layouts/PanelLayout.astro';
import PublishStatus from '@/components/PublishStatus.astro';
import { allPortfolioFiles, portfolioCategories } from '@/lib/images';

// Miniaturas das fotos que já estão publicadas.
const thumbs = Object.fromEntries(
  await Promise.all(
    Object.entries(allPortfolioFiles).map(async ([file, src]) => [file, (await getImage({ src, width: 360, format: 'webp' })).src] as const),
  ),
);
const field = 'mt-1.5 w-full rounded-xl border border-line bg-bg px-4 py-2.5 text-sm text-ink focus:border-brand focus:outline-none';
---

<PanelLayout title="Site: fotos">
  <p class="eyebrow">Site</p>
  <h1 class="mt-1 text-5xl font-extrabold">Editar <span class="text-brand">fotos</span></h1>
  <p class="mt-2 max-w-2xl text-muted">Envie fotos novas, mude legendas e a ordem, oculte ou exclua, e escolha as 3 fotos do topo da página inicial. Ao publicar, o site atualiza em 1 a 2 minutos.</p>

  <div class="mt-6"><PublishStatus /></div>

  <p data-loading class="mt-8 text-muted">Carregando fotos…</p>
  <p data-fail hidden role="alert" class="mt-8 rounded-xl border border-amber-400/40 bg-amber-400/10 p-4 text-amber-100"></p>

  <div data-editor hidden class="pb-28">
    <!-- Enviar fotos -->
    <section class="card mt-8 p-5 sm:p-6" aria-labelledby="up-title">
      <h2 id="up-title" class="text-2xl font-bold">Adicionar fotos</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-[1fr_1.4fr] sm:items-end">
        <label class="block">
          <span class="text-sm font-medium">Categoria</span>
          <select name="folder" class={field}>
            {portfolioCategories.map((c) => <option value={c.folder}>{c.label}</option>)}
          </select>
        </label>
        <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-dashed border-brand/50 bg-bg px-4 py-3 text-sm font-semibold text-brand hover:bg-card/40">
          <input data-files type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" />
          Escolher fotos do computador ou celular
        </label>
      </div>
      <p class="mt-3 text-xs text-muted">JPG, PNG ou WebP. As fotos são reduzidas para no máximo 2000 px (o site fica rápido) e os dados de localização da câmera são removidos. Até 10 fotos por vez.</p>
    </section>

    <!-- Mosaico do topo -->
    <section class="card mt-6 p-5 sm:p-6" aria-labelledby="hero-title">
      <h2 id="hero-title" class="text-2xl font-bold">Mosaico do topo da página inicial</h2>
      <p class="mt-1 text-sm text-muted">A 1ª foto fica grande à esquerda; as outras duas, empilhadas à direita.</p>
      <div data-hero class="mt-4 grid gap-4 md:grid-cols-3"></div>
    </section>

    <!-- Fotos -->
    <section class="mt-6" aria-labelledby="list-title">
      <h2 id="list-title" class="text-2xl font-bold">Fotos do portfólio <span class="font-sans text-base font-normal text-muted" data-total></span></h2>
      <p class="mt-1 text-sm text-muted">A ordem abaixo é a ordem em que aparecem no site (filtro "Todos").</p>
      <ul data-list class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3"></ul>
    </section>
  </div>

  <div data-bar hidden class="fixed inset-x-0 bottom-0 z-40 border-t border-brand/40 bg-bg-2/95 backdrop-blur lg:left-[240px]">
    <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-10">
      <p class="text-sm" data-summary></p>
      <div class="flex gap-2">
        <button type="button" data-discard class="btn btn-outline min-h-10 px-4 text-sm">Descartar</button>
        <button type="button" data-save class="btn btn-primary min-h-10 px-5 text-sm">Publicar no site</button>
      </div>
    </div>
  </div>
</PanelLayout>

<script type="application/json" id="photo-data" set:html={JSON.stringify({ thumbs, folders: portfolioCategories })} />

<script>
  import { ApiError, h, toast } from '@/lib/panel-api';
  import { slugify } from '@/lib/site-content';

  type Item = { file: string; caption: string; hidden: boolean; isNew: boolean; deleted: boolean; preview?: string; base64?: string };
  type Hero = { file: string; label: string; position: string };
  const { thumbs, folders } = JSON.parse(document.getElementById('photo-data')!.textContent!) as {
    thumbs: Record<string, string>;
    folders: { folder: string; label: string }[];
  };
  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const folderLabel = (file: string) => folders.find((f) => f.folder === file.split('/')[0])?.label ?? '';
  const POSITIONS = [
    { value: '50% 50%', label: 'Centro' },
    { value: '50% 25%', label: 'Mais para cima' },
    { value: '50% 75%', label: 'Mais para baixo' },
  ];
  const MAX_TOTAL = 26_000_000; // tamanho máximo por publicação (base64)

  let sha = '';
  let items: Item[] = [];
  let hero: Hero[] = [];
  let snapshot = '';

  const state = () => JSON.stringify({ items: items.map(({ preview: _p, base64: _b, ...i }) => i), hero });
  const dirty = () => state() !== snapshot;
  const visible = () => items.filter((i) => !i.deleted && !i.hidden);

  const updateBar = () => {
    const n = items.filter((i) => i.isNew && !i.deleted).length;
    const d = items.filter((i) => !i.isNew && i.deleted).length;
    $('[data-bar]').hidden = !dirty();
    $('[data-summary]').textContent = [n && `${n} foto(s) nova(s)`, d && `${d} para excluir`, 'alterações não publicadas'].filter(Boolean).join(' · ');
    $('[data-total]').textContent = `(${items.filter((i) => !i.deleted).length})`;
  };

  // ───────── Lista ─────────
  const move = (i: number, to: number) => {
    if (to < 0 || to >= items.length) return;
    const [it] = items.splice(i, 1);
    items.splice(to, 0, it!);
    render();
  };

  const render = () => {
    $('[data-list]').replaceChildren(
      ...items.map((it, i) => {
        const inHero = hero.some((x) => x.file === it.file);
        const li = h('li', `card overflow-hidden ${it.deleted ? 'opacity-40' : ''} ${it.isNew ? 'border-brand/60' : ''}`);
        const media = h('div', 'relative aspect-[4/3] bg-bg');
        const src = it.preview ?? thumbs[it.file];
        if (src) {
          const img = document.createElement('img');
          img.src = src;
          img.alt = it.caption;
          img.loading = 'lazy';
          img.className = `h-full w-full object-cover ${it.hidden ? 'grayscale' : ''}`;
          media.append(img);
        } else {
          media.append(h('p', 'grid h-full place-items-center p-4 text-center text-xs text-muted', 'Publicada recentemente — a miniatura aparece após a próxima atualização da página.'));
        }
        const tags = h('div', 'absolute top-2 left-2 flex flex-wrap gap-1');
        tags.append(h('span', 'rounded-full bg-bg/80 px-2 py-0.5 text-[10px] font-semibold uppercase', folderLabel(it.file)));
        if (it.isNew) tags.append(h('span', 'rounded-full bg-brand px-2 py-0.5 text-[10px] font-bold uppercase text-bg', 'nova'));
        if (inHero) tags.append(h('span', 'rounded-full bg-sky-400/80 px-2 py-0.5 text-[10px] font-bold uppercase text-bg', 'no topo'));
        if (it.hidden) tags.append(h('span', 'rounded-full bg-white/80 px-2 py-0.5 text-[10px] font-bold uppercase text-bg', 'oculta'));
        if (it.deleted) tags.append(h('span', 'rounded-full bg-red-400 px-2 py-0.5 text-[10px] font-bold uppercase text-bg', 'será excluída'));
        media.append(tags);
        li.append(media);

        const body = h('div', 'space-y-3 p-4');
        const cap = h('input', 'w-full rounded-lg border border-line bg-bg px-3 py-2 text-sm focus:border-brand focus:outline-none') as HTMLInputElement;
        cap.value = it.caption;
        cap.maxLength = 120;
        cap.placeholder = 'Legenda (ex.: Queda em campeonato de jiu-jitsu)';
        cap.setAttribute('aria-label', 'Legenda da foto');
        cap.disabled = it.deleted;
        cap.addEventListener('input', () => { it.caption = cap.value; updateBar(); });
        cap.addEventListener('change', renderHero); // atualiza os nomes na escolha do mosaico
        body.append(cap);

        const row = h('div', 'flex flex-wrap items-center gap-1.5');
        const btn = (label: string, onClick: () => void, disabled = false, title = '') => {
          const b = h('button', 'rounded-full border border-line px-3 py-1.5 text-xs hover:border-brand disabled:opacity-30', label) as HTMLButtonElement;
          b.type = 'button';
          b.disabled = disabled;
          if (title) b.title = title;
          b.addEventListener('click', onClick);
          return b;
        };
        row.append(
          btn('↑', () => move(i, i - 1), i === 0 || it.deleted, 'Subir'),
          btn('↓', () => move(i, i + 1), i === items.length - 1 || it.deleted, 'Descer'),
          btn(it.hidden ? 'Mostrar' : 'Ocultar', () => {
            if (!it.hidden && inHero) return toast('Troque essa foto no mosaico do topo antes de ocultar.', 'error');
            it.hidden = !it.hidden; render();
          }, it.deleted),
          btn(it.deleted ? 'Desfazer exclusão' : 'Excluir', () => {
            if (!it.deleted && inHero) return toast('Troque essa foto no mosaico do topo antes de excluir.', 'error');
            if (it.isNew) { items.splice(i, 1); render(); return; }
            it.deleted = !it.deleted; render();
          }),
        );
        body.append(row);
        li.append(body);
        return li;
      }),
    );
    renderHero();
    updateBar();
  };

  // ───────── Mosaico ─────────
  const renderHero = () => {
    const options = visible();
    $('[data-hero]').replaceChildren(
      ...hero.map((hItem, n) => {
        const box = h('div', 'rounded-xl border border-line bg-bg p-3');
        box.append(h('p', 'text-xs font-semibold text-brand uppercase', n === 0 ? 'Foto grande' : `Foto ${n + 1}`));
        const src = items.find((i) => i.file === hItem.file)?.preview ?? thumbs[hItem.file];
        if (src) {
          const img = document.createElement('img');
          img.src = src;
          img.alt = '';
          img.className = 'mt-2 aspect-[4/5] w-full rounded-lg object-cover';
          img.style.objectPosition = hItem.position;
          box.append(img);
        }
        const sel = h('select', 'mt-2 w-full rounded-lg border border-line bg-bg-2 px-2 py-2 text-sm') as HTMLSelectElement;
        sel.setAttribute('aria-label', `Foto ${n + 1} do mosaico`);
        options.forEach((o) => sel.append(Object.assign(document.createElement('option'), { value: o.file, textContent: `${o.caption || o.file.split('/')[1]} (${folderLabel(o.file)})`, selected: o.file === hItem.file })));
        sel.addEventListener('change', () => { hItem.file = sel.value; render(); });
        const label = h('input', 'mt-2 w-full rounded-lg border border-line bg-bg-2 px-2 py-2 text-sm') as HTMLInputElement;
        label.value = hItem.label;
        label.maxLength = 30;
        label.placeholder = 'Etiqueta (ex.: Corrida)';
        label.setAttribute('aria-label', `Etiqueta da foto ${n + 1}`);
        label.addEventListener('input', () => { hItem.label = label.value; updateBar(); });
        const pos = h('select', 'mt-2 w-full rounded-lg border border-line bg-bg-2 px-2 py-2 text-sm') as HTMLSelectElement;
        pos.setAttribute('aria-label', `Enquadramento da foto ${n + 1}`);
        const opts = POSITIONS.some((p) => p.value === hItem.position) ? POSITIONS : [...POSITIONS, { value: hItem.position, label: 'Personalizado' }];
        opts.forEach((p) => pos.append(Object.assign(document.createElement('option'), { value: p.value, textContent: `Enquadrar: ${p.label}`, selected: p.value === hItem.position })));
        pos.addEventListener('change', () => { hItem.position = pos.value; renderHero(); updateBar(); });
        box.append(sel, label, pos);
        return box;
      }),
    );
  };

  // ───────── Envio de fotos (reduz e converte no navegador) ─────────
  const toJpeg = async (file: File): Promise<{ base64: string; preview: string }> => {
    const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' } as ImageBitmapOptions);
    const scale = Math.min(1, 2000 / Math.max(bmp.width, bmp.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bmp.width * scale);
    canvas.height = Math.round(bmp.height * scale);
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise<Blob>((ok, fail) => canvas.toBlob((b) => (b ? ok(b) : fail(new Error('Falha ao converter a foto.'))), 'image/jpeg', 0.88));
    const buf = new Uint8Array(await blob.arrayBuffer());
    let bin = '';
    for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode(...buf.subarray(i, i + 0x8000));
    return { base64: btoa(bin), preview: URL.createObjectURL(blob) };
  };

  ($('[data-files]') as HTMLInputElement).addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const files = [...(input.files ?? [])];
    input.value = '';
    const pending = items.filter((i) => i.isNew).length;
    if (pending + files.length > 10) { toast('Até 10 fotos novas por publicação.', 'error'); return; }
    const folder = (document.querySelector('[name=folder]') as HTMLSelectElement).value;
    for (const f of files) {
      try {
        const { base64, preview } = await toJpeg(f);
        const name = `${slugify(f.name.replace(/\.[^.]+$/, ''))}-${Math.random().toString(36).slice(2, 6)}.jpg`;
        items.unshift({ file: `${folder}/${name}`, caption: '', hidden: false, isNew: true, deleted: false, base64, preview });
      } catch {
        toast(`Não foi possível ler "${f.name}".`, 'error');
      }
    }
    render();
    toast('Fotos adicionadas. Escreva as legendas e publique.');
  });

  // ───────── Carregar / publicar ─────────
  async function load() {
    $('[data-loading]').hidden = false;
    try {
      const res = await fetch('/api/site/portfolio', { credentials: 'same-origin' });
      const data = await res.json();
      if (res.status === 401) { location.href = `/painel/login/?next=${encodeURIComponent(location.pathname)}`; return; }
      if (!res.ok) throw new ApiError(res.status, data.error);
      sha = data.sha;
      const listed = (data.data.photos as { file: string; caption: string; hidden?: boolean }[]).filter((p) => data.files.includes(p.file));
      const extra = (data.files as string[]).filter((f) => !listed.some((p) => p.file === f)).sort();
      items = [
        ...listed.map((p) => ({ file: p.file, caption: p.caption, hidden: !!p.hidden, isNew: false, deleted: false })),
        ...extra.map((f) => ({ file: f, caption: '', hidden: false, isNew: false, deleted: false })),
      ];
      hero = (data.data.hero as Hero[]).map((x) => ({ file: x.file, label: x.label, position: x.position ?? '50% 50%' }));
      snapshot = state();
      render();
      $('[data-editor]').hidden = false;
      $('[data-fail]').hidden = true;
    } catch (e) {
      $('[data-fail]').hidden = false;
      $('[data-fail]').textContent = (e as Error).message || 'Não foi possível carregar as fotos.';
    } finally {
      $('[data-loading]').hidden = true;
    }
  }

  $('[data-discard]').addEventListener('click', () => {
    if (confirm('Descartar todas as alterações não publicadas?')) load();
  });
  $('[data-save]').addEventListener('click', async () => {
    const uploads = items.filter((i) => i.isNew && !i.deleted).map((i) => ({ file: i.file, base64: i.base64! }));
    const size = uploads.reduce((a, u) => a + u.base64.length, 0);
    if (size > MAX_TOTAL) { toast('Muitas fotos de uma vez. Publique em duas etapas.', 'error'); return; }
    if (items.some((i) => i.isNew && !i.deleted && !i.caption.trim())) {
      if (!confirm('Algumas fotos novas estão sem legenda. A legenda ajuda no Google e na acessibilidade. Publicar mesmo assim?')) return;
    }
    const btn = $('[data-save]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = uploads.length ? 'Enviando fotos…' : 'Publicando…';
    try {
      const res = await fetch('/api/site/portfolio', {
        method: 'PUT',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sha,
          data: {
            photos: items.filter((i) => !i.deleted).map((i) => ({ file: i.file, caption: i.caption.trim(), ...(i.hidden ? { hidden: true } : {}) })),
            hero,
          },
          uploads,
          deletes: items.filter((i) => i.deleted && !i.isNew).map((i) => i.file),
        }),
      });
      const data = await res.json().catch(() => ({ error: 'Resposta inválida do servidor.' }));
      if (!res.ok) throw new Error(data.error);
      toast('Publicado! O site atualiza em 1 a 2 minutos.');
      window.dispatchEvent(new Event('venart:published'));
      await load();
    } catch (e) {
      toast((e as Error).message, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Publicar no site';
    }
  });
  window.addEventListener('beforeunload', (e) => { if (dirty()) e.preventDefault(); });
  load();
</script>
