---
/**
 * GALERIA DO EVENTO — /e/<endereço-do-evento>
 * O servidor entrega esta mesma página para qualquer evento (com título e capa do evento);
 * o conteúdo é carregado de /api/public/events/<endereço>.
 * Só as prévias com marca d'água são exibidas. Fora do Google (noindex): quem tem o link encontra.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { messages } from '@/lib/whatsapp';
const field = 'mt-1.5 w-full rounded-xl border border-line bg-bg px-4 py-3 text-ink placeholder:text-muted/60 focus:border-brand focus:outline-none';
---

<BaseLayout title="Fotos do evento" description="Encontre suas fotos do evento e compre em alta resolução." noindex waMessage={messages.general()}>
  <section class="py-8 lg:py-12" data-gallery data-number={site.whatsappNumber}>
    <div class="container-site">
      <p data-loading class="py-16 text-center text-muted">Carregando fotos…</p>

      <div data-error hidden class="card mx-auto max-w-xl p-8 text-center">
        <Icon name="search" size={40} class="mx-auto text-brand" />
        <h1 class="mt-4 text-4xl font-extrabold">Evento não encontrado</h1>
        <p class="mt-2 text-muted">Confira o link recebido. Se o problema continuar, fale comigo pelo WhatsApp.</p>
        <a href="/" class="btn btn-outline mt-6">Ir para o site</a>
      </div>

      <div data-content hidden>
        <header class="max-w-3xl">
          <p data-draft hidden class="mb-3 inline-block rounded-full bg-amber-400/15 px-3 py-1 text-xs font-semibold text-amber-200">Rascunho: só você está vendo (logado no painel)</p>
          <p class="eyebrow" data-when></p>
          <h1 data-name class="mt-1 text-4xl font-extrabold sm:text-6xl"></h1>
          <p data-desc class="mt-3 text-muted"></p>
          <p data-prices class="mt-4 text-sm"></p>
        </header>

        <div data-closed hidden class="card mt-8 p-6">
          <h2 class="text-2xl font-bold">Venda encerrada</h2>
          <p class="mt-1 text-muted">O prazo de venda das fotos deste evento terminou. Se você precisa de alguma foto, me chame no WhatsApp.</p>
        </div>

        <div data-open-area>
          <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-muted"><span data-total></span> Toque nas fotos para ampliar e selecionar as suas.</p>
            <form data-jump class="flex items-center gap-2">
              <label for="jump-n" class="text-sm text-muted">Ir para foto nº</label>
              <input id="jump-n" inputmode="numeric" maxlength="5" class="w-24 rounded-xl border border-line bg-bg px-3 py-2 text-ink focus:border-brand focus:outline-none" />
              <button class="btn btn-outline min-h-10 px-3 text-sm">Ir</button>
            </form>
          </div>

          <ul data-grid class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"></ul>
          <div data-sentinel class="h-10"></div>
          <p data-loading-more hidden class="py-6 text-center text-sm text-muted">Carregando mais fotos…</p>
          <p class="mt-8 text-center text-xs text-muted">
            As fotos exibidas são prévias com marca d'água. A versão comprada vem em alta resolução, sem marca.
          </p>
        </div>
      </div>
    </div>

    <!-- Barra da seleção -->
    <div data-bar hidden class="fixed bottom-4 left-3 right-20 z-40 sm:right-24 sm:left-6">
      <div class="mx-auto flex max-w-2xl items-center justify-between gap-3 rounded-2xl border border-line bg-bg-2/95 p-3 pl-4 shadow-2xl backdrop-blur">
        <div class="min-w-0 text-sm leading-tight">
          <p class="font-semibold"><span data-sel-count></span></p>
          <p class="text-muted"><span data-sel-total></span> <button type="button" data-clear class="ml-1 underline hover:text-ink">limpar</button></p>
        </div>
        <a data-order target="_blank" rel="noopener noreferrer" class="btn btn-primary min-h-11 shrink-0 px-4 text-sm">Pedir pelo WhatsApp</a>
        <button type="button" data-buy hidden class="btn btn-primary min-h-11 shrink-0 px-5 text-sm">Comprar</button>
      </div>
    </div>

    <!-- Compra -->
    <dialog data-checkout class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-line bg-bg-2 p-0 text-ink backdrop:bg-black/70">
      <form data-checkout-form class="space-y-4 p-5 sm:p-6" novalidate>
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="text-3xl font-bold">Finalizar compra</h2>
            <p data-co-summary class="mt-1 text-sm text-muted"></p>
          </div>
          <button type="button" data-co-close class="grid size-10 shrink-0 place-items-center rounded-full hover:bg-white/10" aria-label="Fechar"><Icon name="close" size={20} /></button>
        </div>
        <label class="block"><span class="text-sm font-medium">Nome</span><input name="name" required maxlength="80" autocomplete="name" class={field} /></label>
        <label class="block"><span class="text-sm font-medium">E-mail</span><input name="email" type="email" required maxlength="120" autocomplete="email" class={field} /></label>
        <label class="block">
          <span class="text-sm font-medium">WhatsApp</span>
          <input name="phone" type="tel" required maxlength="20" inputmode="tel" autocomplete="tel" placeholder="(92) 99999-9999" class={field} />
          <span class="mt-1 block text-xs text-muted">Para reenviar o link das fotos, se você precisar.</span>
        </label>
        <label class="flex items-start gap-3 text-sm">
          <input name="accept" type="checkbox" required class="mt-1 size-4 shrink-0 accent-[var(--color-brand)]" />
          <span>Li e aceito os <a href="/termos-de-compra" target="_blank" class="text-brand underline">Termos de compra</a> e a <a href="/privacidade" target="_blank" class="text-brand underline">Privacidade</a>.</span>
        </label>
        <p data-co-error role="alert" class="text-sm text-red-300" hidden></p>
        <button class="btn btn-primary min-h-12 w-full">Ir para o pagamento</button>
        <p class="text-center text-xs text-muted">
          Pix ou cartão, na página segura do Mercado Pago. Depois do pagamento, você volta para cá e baixa as fotos em alta resolução.
        </p>
        <p class="text-center text-xs text-muted">Prefere falar comigo? <a data-buy-wa target="_blank" rel="noopener noreferrer" class="underline hover:text-ink">Pedir pelo WhatsApp</a></p>
      </form>
    </dialog>

    <!-- Foto ampliada -->
    <dialog data-lightbox class="m-auto h-dvh max-h-none w-full max-w-none bg-black p-0 text-ink backdrop:bg-black/80">
      <div class="flex h-full flex-col">
        <div class="flex items-center justify-between gap-3 p-3">
          <p data-lb-label class="font-semibold"></p>
          <button type="button" data-lb-close class="grid size-11 place-items-center rounded-full hover:bg-white/10" aria-label="Fechar"><Icon name="close" size={22} /></button>
        </div>
        <div class="relative flex min-h-0 flex-1 items-center justify-center px-2">
          <img data-lb-img alt="" class="max-h-full max-w-full object-contain select-none" />
          <button type="button" data-lb-prev class="absolute left-1 grid size-12 place-items-center rounded-full bg-black/50 text-2xl hover:bg-black/70" aria-label="Foto anterior">‹</button>
          <button type="button" data-lb-next class="absolute right-1 grid size-12 place-items-center rounded-full bg-black/50 text-2xl hover:bg-black/70" aria-label="Próxima foto">›</button>
        </div>
        <div class="flex justify-center p-4">
          <button type="button" data-lb-select class="btn btn-primary min-h-12 px-6"></button>
        </div>
      </div>
    </dialog>
  </section>
</BaseLayout>

<script>
  import { orderMessage, photoLabel, selectionPrice } from '@/lib/events';
  import { formatBRL, whatsappLink } from '@/lib/whatsapp';
  import { formatDateBR } from '@/lib/proposal';

  type Photo = { id: string; n: number; w: number; h: number };
  type PublicEvent = {
    id: string; slug: string; name: string; date: string; location: string; description: string;
    price_single: number; price_pack: number; photo_count: number; sale_ends_at: string; state: string; checkout: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-gallery]')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const slug = (location.pathname.split('/')[2] ?? '').toLowerCase();
  let ev: PublicEvent;
  const photos: Photo[] = [];
  let next: number | null = 0;
  let loading = false;
  /** Fotos escolhidas: número → id. */
  let selected = new Map<number, string>();
  const storeKey = () => `venart-sel-${ev.id}`;

  const save = () => { try { localStorage.setItem(storeKey(), JSON.stringify([...selected])); } catch { /* sem armazenamento */ } };
  const restore = () => {
    try {
      const raw = JSON.parse(localStorage.getItem(storeKey()) ?? '[]') as unknown[];
      selected = new Map(raw.filter((e): e is [number, string] => Array.isArray(e) && Number.isInteger(e[0]) && /^ph_[a-z0-9]+$/.test(String(e[1]))));
    } catch { selected = new Map(); }
  };

  async function loadMore() {
    if (loading || next === null) return;
    loading = true;
    $('[data-loading-more]').hidden = false;
    try {
      const res = await fetch(`/api/public/events/${encodeURIComponent(slug)}?after=${next}`, { credentials: 'same-origin' });
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as { event: PublicEvent; photos: Photo[]; next: number | null };
      if (!ev) { ev = data.event; restore(); renderHeader(); }
      const start = photos.length;
      photos.push(...data.photos);
      next = data.next;
      appendTiles(start);
    } finally {
      loading = false;
      $('[data-loading-more]').hidden = true;
    }
    // Tela grande: continua carregando até encher.
    if (next !== null && $('[data-sentinel]').getBoundingClientRect().top < innerHeight + 600) loadMore();
  }

  function renderHeader() {
    document.title = `${ev.name} — Fotos | Venart Fotógrafo`;
    $('[data-name]').textContent = ev.name;
    $('[data-when]').textContent = [formatDateBR(ev.date), ev.location].filter(Boolean).join(' · ');
    $('[data-desc]').textContent = ev.description;
    $('[data-desc]').hidden = !ev.description;
    $('[data-draft]').hidden = ev.state !== 'rascunho';
    const closed = ev.state === 'encerrado';
    $('[data-closed]').hidden = !closed;
    $('[data-open-area]').hidden = closed;
    const prices = $('[data-prices]');
    prices.replaceChildren();
    if (!closed) {
      const strong = document.createElement('strong');
      strong.className = 'text-brand';
      strong.textContent = formatBRL(ev.price_single);
      prices.append('Cada foto ', strong);
      if (ev.price_pack > 0) {
        const pack = document.createElement('strong');
        pack.className = 'text-brand';
        pack.textContent = formatBRL(ev.price_pack);
        prices.append(' · Todas as suas fotos por ', pack);
      }
      if (ev.sale_ends_at) prices.append(` · Disponível até ${formatDateBR(ev.sale_ends_at.slice(0, 10))}`);
    }
    $('[data-total]').textContent = `${ev.photo_count} fotos.`;
    $('[data-content]').hidden = false;
    $('[data-loading]').hidden = true;
    renderBar();
  }

  function tile(p: Photo, index: number) {
    const li = document.createElement('li');
    li.className = 'relative';
    li.dataset.n = String(p.n);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'block aspect-[4/3] w-full overflow-hidden rounded-lg bg-bg-2 ring-brand focus-visible:ring-2';
    btn.setAttribute('aria-label', `Ampliar foto ${photoLabel(p.n)}`);
    const img = document.createElement('img');
    img.src = `/f/${ev.id}/${p.id}/thumb.jpg`;
    img.alt = `Foto ${photoLabel(p.n)}`;
    img.loading = 'lazy';
    img.decoding = 'async';
    img.className = 'size-full object-cover';
    btn.append(img);
    btn.addEventListener('click', () => openLightbox(index));
    const check = document.createElement('button');
    check.type = 'button';
    check.className = 'absolute top-1.5 right-1.5 grid size-9 place-items-center rounded-full border-2 border-white/80 bg-black/40 text-sm font-bold';
    check.addEventListener('click', () => toggle(p));
    const label = document.createElement('span');
    label.className = 'pointer-events-none absolute bottom-1.5 left-1.5 rounded bg-black/60 px-1.5 text-[11px] font-semibold';
    label.textContent = photoLabel(p.n);
    li.append(btn, check, label);
    paintTile(li);
    return li;
  }

  function paintTile(li: HTMLElement) {
    const n = Number(li.dataset.n);
    const on = selected.has(n);
    const check = li.querySelectorAll('button')[1]!;
    check.textContent = on ? '✓' : '';
    check.className = `absolute top-1.5 right-1.5 grid size-9 place-items-center rounded-full border-2 text-sm font-bold ${on ? 'border-brand bg-brand text-bg' : 'border-white/80 bg-black/40'}`;
    check.setAttribute('aria-pressed', String(on));
    check.setAttribute('aria-label', `${on ? 'Remover' : 'Selecionar'} foto ${photoLabel(n)}`);
    li.querySelector('img')!.classList.toggle('opacity-80', on);
  }

  function appendTiles(start: number) {
    const grid = $('[data-grid]');
    photos.slice(start).forEach((p, i) => grid.append(tile(p, start + i)));
  }

  function toggle(p: Photo) {
    const n = p.n;
    if (selected.has(n)) selected.delete(n); else selected.set(n, p.id);
    save();
    const li = root.querySelector<HTMLElement>(`[data-grid] li[data-n="${n}"]`);
    if (li) paintTile(li);
    renderBar();
    if (lb.open) paintLightbox();
  }

  function renderBar() {
    const count = selected.size;
    $('[data-bar]').hidden = count === 0 || ev.state === 'encerrado';
    if (!count) return;
    const p = selectionPrice(count, ev);
    $('[data-sel-count]').textContent = `${count} foto${count === 1 ? '' : 's'} selecionada${count === 1 ? '' : 's'}`;
    $('[data-sel-total]').textContent = `${formatBRL(p.total)}${p.usePack ? ' (pacote)' : ''}`;
    const wa = whatsappLink(root.dataset.number!, orderMessage(ev, [...selected.keys()], `${location.origin}/e/${ev.slug}`));
    $<HTMLAnchorElement>('[data-order]').href = wa;
    $<HTMLAnchorElement>('[data-buy-wa]').href = wa;
    $('[data-order]').hidden = ev.checkout;
    $('[data-buy]').hidden = !ev.checkout;
  }
  $('[data-clear]').addEventListener('click', () => {
    if (!confirm('Limpar a seleção?')) return;
    selected.clear(); save(); renderBar();
    root.querySelectorAll<HTMLElement>('[data-grid] li').forEach(paintTile);
  });

  // ── Compra (Mercado Pago) ──
  const co = $<HTMLDialogElement>('[data-checkout]');
  const coForm = $<HTMLFormElement>('[data-checkout-form]');
  const BUYER_KEY = 'venart-comprador';
  $('[data-buy]').addEventListener('click', () => {
    const p = selectionPrice(selected.size, ev);
    $('[data-co-summary]').textContent = `${selected.size} foto${selected.size === 1 ? '' : 's'} · ${formatBRL(p.total)}${p.usePack ? ' (pacote)' : ''}`;
    try {
      const saved = JSON.parse(localStorage.getItem(BUYER_KEY) ?? '{}') as Record<string, string>;
      for (const k of ['name', 'email', 'phone']) {
        const input = coForm.elements.namedItem(k) as HTMLInputElement;
        if (!input.value && typeof saved[k] === 'string') input.value = saved[k]!;
      }
    } catch { /* sem armazenamento */ }
    $('[data-co-error]').hidden = true;
    co.showModal();
  });
  $('[data-co-close]').addEventListener('click', () => co.close());
  coForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(coForm)) as Record<string, string>;
    const err = $('[data-co-error]');
    const btn = coForm.querySelector<HTMLButtonElement>('button:not([type])')!;
    btn.disabled = true;
    btn.textContent = 'Abrindo o pagamento…';
    err.hidden = true;
    try {
      try { localStorage.setItem(BUYER_KEY, JSON.stringify({ name: d.name, email: d.email, phone: d.phone })); } catch { /* ok */ }
      const res = await fetch('/api/public/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: ev.slug, photo_ids: [...selected.values()], name: d.name, email: d.email, phone: d.phone, accept: d.accept === 'on' }),
      });
      const data = (await res.json().catch(() => ({}))) as { error?: string; checkout_url?: string; token?: string };
      if (!res.ok || !data.checkout_url) throw new Error(data.error ?? 'Não foi possível iniciar o pagamento. Tente de novo.');
      // Guarda o link do pedido neste aparelho (para voltar depois, mesmo sem o e-mail).
      try {
        const list = JSON.parse(localStorage.getItem('venart-pedidos') ?? '[]') as unknown[];
        localStorage.setItem('venart-pedidos', JSON.stringify([{ token: data.token, event: ev.name, at: Date.now() }, ...list].slice(0, 20)));
      } catch { /* ok */ }
      selected.clear(); save();
      location.href = data.checkout_url;
    } catch (ex) {
      err.textContent = (ex as Error).message;
      err.hidden = false;
      btn.disabled = false;
      btn.textContent = 'Ir para o pagamento';
    }
  });

  // ── Foto ampliada ──
  const lb = $<HTMLDialogElement>('[data-lightbox]');
  let current = 0;
  function paintLightbox() {
    const p = photos[current]!;
    const on = selected.has(p.n);
    $('[data-lb-label]').textContent = `Foto ${photoLabel(p.n)}`;
    const sel = $('[data-lb-select]');
    sel.textContent = on ? '✓ Selecionada — remover' : 'Selecionar esta foto';
    sel.className = `btn min-h-12 px-6 ${on ? 'btn-outline' : 'btn-primary'}`;
    $<HTMLButtonElement>('[data-lb-prev]').hidden = current === 0;
    $<HTMLButtonElement>('[data-lb-next]').hidden = current >= photos.length - 1 && next === null;
  }
  function showPhoto(i: number) {
    current = Math.max(0, Math.min(i, photos.length - 1));
    const p = photos[current]!;
    const img = $<HTMLImageElement>('[data-lb-img]');
    img.src = `/f/${ev.id}/${p.id}/preview.jpg`;
    img.alt = `Foto ${photoLabel(p.n)} (prévia com marca d'água)`;
    paintLightbox();
    // Pré-carrega a próxima.
    const nx = photos[current + 1];
    if (nx) new Image().src = `/f/${ev.id}/${nx.id}/preview.jpg`;
    if (current >= photos.length - 3) loadMore();
  }
  function openLightbox(i: number) { showPhoto(i); lb.showModal(); }
  $('[data-lb-close]').addEventListener('click', () => lb.close());
  $('[data-lb-prev]').addEventListener('click', () => showPhoto(current - 1));
  $('[data-lb-next]').addEventListener('click', () => showPhoto(current + 1));
  $('[data-lb-select]').addEventListener('click', () => toggle(photos[current]!));
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') showPhoto(current - 1);
    if (e.key === 'ArrowRight') showPhoto(current + 1);
  });
  // Deslizar para os lados no celular.
  let touchX = 0;
  lb.addEventListener('touchstart', (e) => { touchX = e.touches[0]!.clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0]!.clientX - touchX;
    if (Math.abs(dx) > 50) showPhoto(current + (dx < 0 ? 1 : -1));
  });

  // ── Ir para número ──
  $('[data-jump]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const n = Number.parseInt($<HTMLInputElement>('#jump-n').value, 10);
    if (!n) return;
    while (!photos.some((p) => p.n >= n) && next !== null) await loadMore();
    const li = root.querySelector<HTMLElement>(`[data-grid] li[data-n="${n}"]`);
    if (li) { li.scrollIntoView({ behavior: 'smooth', block: 'center' }); li.querySelector('button')!.focus({ preventScroll: true }); }
    else alert(`Foto ${photoLabel(n)} não encontrada.`);
  });

  // ── Início ──
  new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting) && ev) loadMore(); }, { rootMargin: '800px' }).observe($('[data-sentinel]'));
  loadMore().catch(() => {
    $('[data-loading]').hidden = true;
    $('[data-error]').hidden = false;
  });
</script>
